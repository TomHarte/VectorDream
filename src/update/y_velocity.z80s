	; Apply.
	ld a, (player.y + 2)
	ld d, a
	ld hl, (player.y)					; D:HL = player.y

	ld a, (player.yvelocity + 1)
	rla
	sbc a
	ld bc, (player.yvelocity)			; A:BC = velocity, sign extended.

	add hl, bc
	adc d

	ld (player.y), hl
	ld (player.y + 2), a

	ld a, (player.yvelocity + 1)
	sra a

	; Dampen.
	ex de, hl
	ld h, 0x00
	ld l, a
	or a
	jp p, @+positive
	ld h, 0xff
	@positive:

	add hl, hl
	ex de, hl

	ld hl, (player.yvelocity)
	or a
	sbc hl, de
	ld (player.yvelocity), hl
