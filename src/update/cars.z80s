NUM_CARS: EQU 4

@found_cars:
	db 0

cars.update:
	; Zero-out list of cars that are currently live.
	; This will be repopulated as the update functions are run.
	xor a
	ld (@-found_cars), a

@update_object: EQU FOR active_objects.count
@object_base: EQU active_objects + @update_object * sizeof.object

@process_object:
	ld a, (@object_base + offset.object.depth + 1)				; Test for high byte of distance = 0xff as a list terminator.
	inc a
	jp z, @+objects_done			; TODO: could be JR in later iterations?

	; Call update function
	ld hl, (@object_base + offset.object.draw)		; HL now points to draw block.
	ld de, @object_base
	call object.update

	; Erase object if carry is set.
	jr nc, @+next_object

	ld de, @object_base
	call active_objects.erase
	jr @-process_object					; Erasing eliminated what was in this slot so now something else is here.
										; Therefore repeat at the same spot.

@next_object:
	NEXT @update_object


@objects_done:
	;
	; If there are already three active cars, add no more.
	;
	ld a, (@-found_cars)
	cp (1 << NUM_CARS) - 1
	jr z, @+too_many_cars

	;
	; Otherwise require that (cars.time_since_added / 16) is greater than
	; the current refresh count, as a broad-sweeps randomisation strategy
	; that's possibly to be revised.
	;
	ld a, (cars.time_since_added)
	rra
	rra
	rra
	rra
	and %00001111
	ld d, a

	call random.byte
	cp d
	jr nc, @+add_no_cars

	; TODO:
	;
	;	(1)	are there any car slots free? If not, don't add any cars.
	;	(2)	if so, something like: is the amount of time since a car was added
	;		greater than the current refresh register value? If so, add a car now:
	;
	;		(a) pick an x position, between appropriate bounds;
	;		(b)	pick a velocity, probably between 7 and 9. There's not a lot of precision here;
	;		(c)	if player velocity is greater than or equal, add at the horizon. Otherwise add
	;			at the near clip plane.
	;
	; Update total of time since car added, either way.
	;

	; Ensure player is going fast enough to make an over-the-horizon car sensible,
	; or else slow enough for a from-behind car.
	ld a, (player.yvelocity + 1)
	cp 5
	jr c, @+add_car_near			; Velocity < 5 => car from behind.

	cp 9
	jr c, @+add_no_cars				; Velocity > 9 => car from front.

@add_car_far:
	; Try to get a spot in the object table.
	call active_objects.front_reserve
	ld bc, max_object_depth
	jr @+add_car

@add_car_near:
	; Try to get a spot in the object table.
	call active_objects.back_reserve
	ld bc, min_object_depth
	; [[fallthrough]]

@add_car:
	; Add (and randomise) only if a list spot was available.
	jr c, @+add_no_cars
	call @+randomise_car
	jr @+check_roadside_objects

@add_no_cars:
	ld a, (cars.time_since_added)
	inc_a_clamped
	ld (cars.time_since_added), a
	jr @+check_roadside_objects

@too_many_cars:
	; Zero out count; no cars were added but it's good to have a delay between three cars
	; being visble and the next appearing.
	xor a
	ld (cars.time_since_added), a

@check_roadside_objects:
	; Additional TODO: consult list of fixed objects (trees, signs, etc), possibly adding one of those
	; to the active list.

	ret



;
; @randomise_car
;
; Zeroes out cars.time_since_added and stores whatever is currently in BC as the new car's seed depth.
; Finds an available car slot and randomises the car's x location and colour.
;
;	Inputs:
;		HL = pointer to car insertion location within the objects list;
;		BC = depth at which the car will first appear.
;
;	Outputs:
;		None.
;
;	Clobbers:
;		A, BC, DE, HL.
;
@randomise_car:
	; Zero out count since car added.
	xor a
	ld (cars.time_since_added), a

	; Store depth that was provided.
	ld (hl), c
	inc l
	ld (hl), b
	inc l

	; Pick a car slot to use.
	ld a, (@-found_cars)
@test_slot: EQU FOR NUM_CARS - 1
	rra
	jr c, @+test_next

	ld bc, car{@test_slot}.draw
	ld de, car{@test_slot}
	jr @+fill_in_car

@test_next:
NEXT @test_slot

	; Implicitly: randomise final car.
	ld bc, car{NUM_CARS - 1}.draw
	ld de, car{NUM_CARS - 1}
	; [[fallthrough]]

@fill_in_car:
	; Here:
	;	BC = draw function for this car;
	;	DE = object block for this car;
	;	HL = pointer into object list, at position where draw function should be stored.

	; Store draw object pointer.
	ld (hl), c
	inc l
	ld (hl), b

	; Pick a random x location.
	; (for a very loose sense of random, here and below)
	call random.byte
	sra a
	ld b, a
	sra a
	add b
	ld (de), a
	inc de

	; Pick a random colour.
	call random.nibble.spread
	rra
	jr nc, @+add_blue

	ld a, colour.car.red
	jr @+store_colour

@add_blue:
	ld a, colour.car.blue

@store_colour:
	ld (de), a
;	inc de

	; Pick a random speed between 6 and 9.
	;
	; Disabled for now as an MVP simplification; keeping them all at the same speed means
	; never having to worry about them colliding with each other.
	;
;	ld a, r
;	and 3
;	add 6
;	ld (de), a

	; TODO: do I ever need to worry about zeroing out the top byte of velocity?
	; xor a
	; ld (de), a
	; inc de

	ret

@car: EQU FOR NUM_CARS
;
; carX.update
;
; Updates the positioning and other state of carX.
;
;	Inputs:
;		DE = pointer to start of object record.
;
car{@car}.update:
	;
	; Record that this car has been sighted during the update loop.
	; This record will become relevant if the decision is made to add a new car.
	;
	ld a, (@-found_cars)
	or 1 << @car
	ld (@-found_cars), a

	;
	; Establish BC = car velocity, HL = pointer to car within object list.
	;
	ld bc, (car{@car} + car.velocity)
	ex de, hl
	jp @+car.update

car{@car}.collide:
	;
	; If this is called then vertical placement has already been tested.
	; Just test horizontal.
	;
	ld bc, (car{@car} + car.velocity - 1)	; B = velocity.
	ld a, (car{@car} + car.x)				; A = x position.
	jp @+car.collide
NEXT @car


;
; @car.update
;
; Applies the sum of player and car velocity to the car, moving it in relative space.
; Tests whether it has gone outside of the visible area.
;
;	Inputs:
;		BC = car velocity;
;		HL = pointer to car object within object list.
;
;	Outputs:
;		Carry set => car is out of bounds and can be deleted;
;		Carry clear => car is still within bounds.
;
;	Clobbers:
;		A, DE, HL, BC.
;
@car.update:
	push bc

	ld a, (player.yvelocity + 1)
	ld c, a
	rla
	sbc a
	ld b, a							; BC = top 16 bits of velocity.

	ld e, (hl)						; HL points to object depth.
	inc l
	ld d, (hl)
	ex de, hl						; HL = object depth, DE = pointer to high byte of depth.

	or a
	sbc hl, bc						; Subtract the player's velocity.
	jp p, @+no_front_clip			; Check for crossing of near-Z.

	pop af							; Remove backed-up value of BC from stack.
	scf
	ret

@no_front_clip:
	pop bc							; Add something for car velocity.
	add hl, bc

	; Has the car disappeared over the horizon?
	ld a, l
	sub max_object_depth \ 256
	ld a, h
	sbc max_object_depth / 256
	jr c, @+no_back_clip

	scf
	ret

@no_back_clip:
	ex de, hl
	ld (hl), d
	dec l
	ld (hl), e

	or a
	ret

;
; @car.collide
;
; Tests whether the player is within appropriate horizontal bounds of this car.
; If so then reduces the player's velocity and fuel to effect a collision.
;
;	Inputs:
;		B = car velocity;
;		A = car x position.
;
;	Clobbers:
;		A, BC, HL.
;
@car.collide:
	; Car X position is a single byte in the range +127 (extreme right hand side of road) to -128 (extreme left).
	; Player x position is a two-byte fixed-point value with half the local precision, i.e. it's in the range +63 to -64 and has 8 bits of fractional placement.
	; Player x also runs in the opposite direction from car x.
	; Easiest solution: convert car x to player range

	sra a
	neg
	ld c, a					; B = car x, converted to player's range.

	ld a, (player.x + 1)	; A = player x, in native range.

	; Require: b + car.width > a > b - car.width.
	; If hit, reduce player velocity to some smaller proportion of car velocity (in C).

	sub c

	jp p, @+no_neg
	neg
@no_neg:

	cp 32		; Arbitrary. To tweak.
	ret nc

	; Actual collision!
	;
	; First attempt: reduce player velocity to 75% of the car it just hit.
	;
	ld c, 0

	sra b
	rr c

	ld h, b
	ld l, c

	sra b
	rr c

	add hl, bc

	ld (player.yvelocity), hl

	ret
