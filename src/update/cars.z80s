@car: EQU FOR NUM_CARS
;
; carX.update
;
; Updates the positioning and other state of carX.
;
;	Inputs:
;		DE = pointer to start of object record.
;
car{@car}.update:
	;
	; Record that this car has been sighted during the update loop.
	; This record will become relevant if the decision is made to add a new car.
	;
	ld a, (found_cars)
	or 1 << @car
	ld (found_cars), a

	;
	; Establish BC = car velocity, HL = pointer to car within object list.
	;
	ld bc, (car{@car} + offsetof.car.velocity)
	ex de, hl
	jp @+car.update

car{@car}.collide:
	;
	; If this is called then vertical placement has already been tested.
	; Just test horizontal.
	;
	ld bc, (car{@car} + offsetof.car.velocity - 1)	; B = velocity.
	ld a, (car{@car} + offsetof.car.x)				; A = x position.
	jp @+car.collide
NEXT @car


;
; @car.update
;
; Applies the sum of player and car velocity to the car, moving it in relative space.
; Tests whether it has gone outside of the visible area.
;
;	Inputs:
;		BC = car velocity;
;		HL = pointer to car object within object list.
;
;	Outputs:
;		Carry set => car is out of bounds and can be deleted;
;		Carry clear => car is still within bounds.
;
;	Clobbers:
;		A, DE, HL, BC.
;
@car.update:
	ld e, (hl)						; HL points to object depth.
	inc l
	ld d, (hl)
	ex de, hl						; HL = object depth, DE = pointer to high byte of depth.

	add hl, bc						; Add car velocity.
	jp object.apply_player_velocity


;
; @car.collide
;
; Tests whether the player is within appropriate horizontal bounds of this car.
; If so then reduces the player's velocity and fuel to effect a collision.
;
;	Inputs:
;		B = car velocity;
;		A = car x position.
;
;	Clobbers:
;		A, BC, HL.
;
@car.collide:
	; Car X position is a single byte in the range +127 (extreme right hand side of road) to -128 (extreme left).
	; Player x position is a two-byte fixed-point value with half the local precision, i.e. it's in the range +63 to -64 and has 8 bits of fractional placement.
	; Player x also runs in the opposite direction from car x.
	; Easiest solution: convert car x to player range

	sra a
	neg
	ld c, a					; B = car x, converted to player's range.

	ld a, (player.x + 1)	; A = player x, in native range.

	; Require: b + car.width > a > b - car.width.
	; If hit, reduce player velocity to some smaller proportion of car velocity (in C).

	sub c

	jp p, @+no_neg
	neg
@no_neg:

	cp 32		; Arbitrary. To tweak.
	ret nc

	; Actual collision!
	;
	; First attempt: reduce player velocity to 75% of the car it just hit.
	;
	ld c, 0

	sra b
	rr c

	ld h, b
	ld l, c

	sra b
	rr c

	add hl, bc

	ld (player.yvelocity), hl

	ret
