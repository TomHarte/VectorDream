NUM_CARS: EQU 3

@found_cars:
	db 0

cars.update:
	xor a
	ld (@-found_cars), a
	ld hl, active_objects + 2	; (HL) = first draw function.

@update_object:
	push hl

	ld e, (hl)
	inc l
	ld d, (hl)					; DE = draw function.

	ex de, hl					; HL = draw function.
	dec hl
	dec hl						; (HL) = update function.

	ld e, (hl)
	inc hl
	ld d, (hl)
	ex de, hl					; HL = update function.
								; DE = pointer into list.

	pop de
	call call_hl

	inc l
	inc l
	inc l

	ld a, (hl)				; Test for high byte of distance = 0xff as a list terminator.
	inc a
	jr z, @+objects_done

	inc l
	jr @-update_object

@objects_done:

	;
	; If there are already three active cars, add no more.
	;
	ld a, (@-found_cars)
	cp 7
	jr z, @+add_no_cars

	;
	; Otherwise require that (cars.time_since_added / 8) is greater than
	; the current refresh count, as a broad-sweeps randomisation strategy
	; that's possibly to be revised.
	;
	ld a, (cars.time_since_added)
	rra
	rra
	rra
	rra
	and %00001111
	ld b, a

	ld a, r
	cp b
	jr nc, @+add_no_cars

	; TODO:
	;
	;	(1)	are there any car slots free? If not, don't add any cars.
	;	(2)	if so, something like: is the amount of time since a car was added
	;		greater than the current refresh register value? If so, add a car now:
	;
	;		(a) pick an x position, between appropriate bounds;
	;		(b)	pick a velocity, probably between 7 and 9. There's not a lot of precision here;
	;		(c)	if player velocity is greater than or equal, add at the horizon. Otherwise add
	;			at the near clip plane.
	;
	; Update total of time since car added, either way.
	;

@add_car:
	; Ensure player is going fast enough to make an over-the-horizon car sensible,
	; or else slow enough for a from-behind car.
	ld a, (player.yvelocity + 1)
	cp 3
	jr c, @+add_car_behind			; Velocity < 3 => car from behind.

	cp 6
	jr c, @+add_no_cars				; Velocity > 6 => car from front.

@add_car_front:
@add_car_behind:

	; Zero out count since car added.
	xor a
	ld (cars.time_since_added), a

	;
	; ... something ...
	;

	jr @+check_roadside_objects

@add_no_cars:
	ld a, (cars.time_since_added)
	inc_a_clamped
	ld (cars.time_since_added), a

@check_roadside_objects:
	; Additional TODO: consult list of fixed objects (trees, signs, etc), possibly adding one of those
	; to the active list.

	ret



call_hl:
	jp (hl)

;
; Update functions.
;
;	Inputs:
;		DE = pointer to low byte of update function within active objects list.
;
;	Outputs:
;		HL = pointer to low byte of update function within active obejcts list.
;

update_car1:
	ld a, (@-found_cars)
	or 1
	ld (@-found_cars), a

	ld bc, (car1 + 2)
	ex de, hl
	jp @+add_player_velocity

update_car2:
	ld a, (@-found_cars)
	or 2
	ld (@-found_cars), a

	ld bc, (car2 + 2)
	ex de, hl
	jp @+add_player_velocity

update_car3:
	ld a, (@-found_cars)
	or 4
	ld (@-found_cars), a

	ld bc, (car3 + 2)
	ex de, hl
	jp @+add_player_velocity


collide_car1:
collide_car2:
collide_car3:
	ret


@add_player_velocity:
	push bc

	ld a, (player.yvelocity + 1)
	ld c, a
	rla
	sbc a
	ld b, a							; BC = top 16 bits of velocity.

	dec l							; HL points to high byte of object depth.
	ld d, (hl)
	dec l
	ld e, (hl)
	ex de, hl						; HL = object depth, DE = pointer to high byte of depth.

	or a
	sbc hl, bc						; Subtract the player's velocity.
	jp p, @+no_front_clip			; Check for crossing of near-Z.

	pop af							; Remove backed-up value of BC from stack.
	ex de, hl						; Remove object.
	call active_objects.remove

	pop hl							; Restore HL and return.
	ret

@no_front_clip:
	pop bc							; Add something for car velocity.
	add hl, bc

	; Has the car disappeared over the horizon?
	ld a, l
	sub max_object_depth \ 256
	ld a, h
	sbc max_object_depth / 256
	jr c, @+no_back_clip

	ld hl, depth_135

@no_back_clip:
	ex de, hl
	ld (hl), e
	inc l
	ld (hl), d
	inc l

	ret