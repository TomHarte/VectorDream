	;
	; Is a segment currently ongoing?
	;

@check_current_segment:
	ld hl, (@-next_curvature_tick)
	ld a, h
	or l
	jr z, @+check_for_new_segment

@check_next_curvature_tick:
	ex de, hl
	ld hl, (player.y + 1)
	sbc hl, de

	jr c, @+track_done		; Not past next tick position yet.

	; Apply tick.
	ld iy, (current_segment)
	ld a, (iy + segment.tick_direction)
	or a
	jr z, @+tick_negative

	ld hl, (curvature)
	inc hl
	ld (curvature), hl
	call road.curve_right

	jr @+post_tick

@tick_negative:
	ld hl, (curvature)
	dec hl
	ld (curvature), hl
	call road.curve_left

@post_tick:
	; Compare 'curvature' and target, potentially to set next_curvature_tick to 0
	; and thereby end the segment.
	ld l, (iy + segment.tick_target)
	ld h, (iy + segment.tick_target + 1)
	ld de, (curvature)
	or a
	sbc hl, de
	jr nz, @+continue_segment

	xor a
	ld (@-next_curvature_tick), a
	ld (@-next_curvature_tick + 1), a		; Zero-out next_curvature_tick. No curve ongoing.

	ld hl, (current_segment)
	ld bc, segment.size
	add hl, bc
	ld (current_segment), hl				; Advance segment pointer.

	jr @+track_done

@continue_segment:
	ld hl, (@-next_curvature_tick)
	ld e, (iy + segment.tick_distance)
	ld d, (iy + segment.tick_distance + 1)
	add hl, de
	ld (@-next_curvature_tick), hl
	jr @-check_next_curvature_tick			; Guard against multiple ticks being due.

@check_for_new_segment:
	ld iy, (current_segment)
	ld a, iyh
	or iyl
	jr z, @+track_done

	; IY points to segment.
	ld e, (iy + segment.position)
	ld d, (iy + segment.position + 1)
	ld hl, (player.y + 1)
	sbc hl, de

	jr c, @+track_done

	ld l, (iy + segment.tick_distance)
	ld h, (iy + segment.tick_distance + 1)
	add hl, de
	ld (@-next_curvature_tick), hl
	jp @-check_current_segment

	nop				; TODO: install segment, jump back to segment processor.

@track_done:
