	;
	; Apply drag.
	;
	ld a, (player.yvelocity + 1)
	sra a

	ex de, hl
	ld h, 0x00
	ld l, a
	or a
	jp p, @+positive
	ld h, 0xff
	@positive:

	add hl, hl
	ex de, hl

	ld hl, (player.yvelocity)
	or a
	sbc hl, de

	; Check tyre_flags.left and tyre_flags.right for potential extra friction.
	;
	; Reuse but increase the existing calculation of drag in DE.
	inc de
	sla e
	rl d

	ld a, (tyre_flags.left)
	rra
	jr nc, @+not_offroad

	or a
	sbc hl, de

	@not_offroad:
	ld a, (tyre_flags.right)
	rra
	jr nc, @+not_offroad

	or a
	sbc hl, de

	@not_offroad:

	;
	; Check that HL hasn't gone overly negative.
	;
	ld bc, 0x6000
	or a
	sbc hl, bc
	jr c, @+hl_fine

	ld hl, 0
	ld (player.yvelocity), hl
	jr @+y_velocity_done

	@hl_fine:
	add hl, bc
	ld (player.yvelocity), hl

	@y_velocity_done:
