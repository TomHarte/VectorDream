;
; Called once per frame by by span_buffers/game_loop.z80s.
;
; Should not call spans.swap or similar; span buffer swapping is handled by the game loop.
;
draw:
	call road.draw
	call objects.draw
	jp protect_fuel_rpm

;
; Called once at initial program launch to give a chance to paint in any permanent pixel assets.
;
setup_overlay:
	jp install_fuel_rpm
