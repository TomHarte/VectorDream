;
; getratio.uf16.uf16
;
; Performs the fixed-point calculation HL = BC / DE.
;
;	Input:
;		BC = dividend;
;		DE = divisor;
;		Requires BC >= 0, DE >= 0, BC < DE.
;
;	Output:
;		B = dividend / divisor, in 0:8 fixed point.
;
;	Clobbers:
;		BC, HL.
;

getratio.uf16.uf16:
	ld h, b
	ld l, c

@divide_loop: EQU FOR 8
	sl1 b			; Presume the newest bit is set.
	add hl, hl		; HL <<= 1; carry is always 0.

	sbc hl, de		; Check whether HL is really greater than DE.
	jr nc, @+noadd

	add hl, de		; HL wasn't greater than DE, so restore its old value.
	dec b			; Clear lowest bit.
@noadd:
	NEXT @divide_loop

	ret
