;
; fixdiv and fixdivpositive
;
; Calculates HL = DE / BC, where all are in signed 8.8 fixed point.
;
; fixdiv accepts any sign of dividend and divisor.
; fixdivpositive assumes both positive.
;
;	Input:
;		DE = dividend;
;		BC = divisor.
;
;	Output:
;		HL = dividend / divisor.
;
;	Clobbers:
;		A, BC, DE.
;
fixdiv:
	; Check signs.
	ld a, d
	or a
	jp p, @+check_bc

	; DE is negative.
	ld a, b
	or a
	jp p, @+divnegpos

	; Both are negative. Easy...
	ld hl, 0
	sbc hl, de
	ex de, hl
	ld hl, 0
	and a
	sbc hl, bc
	ld b, h
	ld c, l
	jr @+divpospos

@check_bc:			; DE is positive. Check BC.
	ld a, b
	and a
	jp m, @+divposneg

fixdivpositive:
@divpospos:			; Both BC and DE are positive.
	ld hl, 0

@DIVLOOP1: EQU FOR 8
	sla d
	rl l			; L:B <<= 1

	sbc hl, bc		; Find HL - DE (carry is known to be clear).
	jr nc, @+noadd	; HL <= DE so no adjustment necessary.

	add hl, bc		; HL < DE; add DE back in.
@noadd:
	NEXT @DIVLOOP1

				; Now: B is the lowest byte of the answer, which we just throw away.
dtpos:
@DIVLOOP2: EQU FOR 8
	sl1 e
	adc hl, hl			; HL:C = (HL:C << 1) | 1

	sbc hl, bc			; HL -= DE (as carry is known clear).
	jr nc, @+noadd		; HL <= DE => no adjustment.

	add hl, bc			; HL. DE; add DE back in.
	dec e				; Remove bottom bit of C.
@noadd:
	NEXT @DIVLOOP2

				; Now: C is the high byte of the answer...

@DIVLOOP3: EQU FOR 8
	sl1 d

	add hl, hl			; HL <<= 1, ignoring any carry from B.
	and a				; Clear carry.
	sbc hl, bc			; HL -= DE.
	jr nc, @+noadd		; HL >= DE => no add.

	add hl, bc			; HL < DE, add DE back in, and...
	dec d				; Clear bottom bit of B.
@noadd:
	NEXT @DIVLOOP3

				; ... and B is middle byte of the answer.

	ld h, e				; Transpose BC into HL.
	ld l, d
dlend:	ret

@divposneg:
	; Negative DE.
	ld hl, 0
	and a
	sbc hl, bc
	ld b, h
	ld c, l
	call @-divpospos
	ex de, hl
	ld hl, 0
	and a
	sbc hl, de
	ret

@divnegpos:
	; Negative BC.
	ld hl, 0
	and a
	sbc hl, de
	ex de, hl
	call @-divpospos
	ex de, hl
	ld hl, 0
	and a
	sbc hl, de
	ret
