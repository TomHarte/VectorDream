; Adds the 8-bit unsigned value in A to HL. Clobbers A.
add_hl_a: MACRO
	add a, l
	ld l, a

	adc h
	sub l
	ld h, a
	ENDM

; Subtracts the 8-bit unsigned value in A from HL.
; Works correctly only if A is non-zero.
; Clobbers A.
sub_hl_a_nonzero: MACRO
	neg
	add l
	ld l, a

	ld a, 0xff
	adc h
	ld h, a
	ENDM

; Adds the 8-bit unsigned value \0 in to DE. Clobbers A.
add_de: MACRO
	ld a, e
	add \0
	ld e, a

	adc d
	sub e
	ld d, a
	ENDM

; Subtracts the 8-bit unsigned value in \0 from DE. Clobbers A.
sub_de: MACRO
	ld a, e
	sub \0
	ld e, a

	ld a, d
	sbc 0
	ld d, a
	ENDM

; Increments A, saturating at 0xff.
inc_a_clamped: MACRO
	add 1
	sbc 0
	ENDM

; Decrements A, clamping at 0x00.
dec_a_clamped: MACRO
	sub 1
	adc 0
	ENDM

; Gets a sign-extended version of the integral part of player velocity into BC.
; Clobbers A.
get_player_velocity_bc: MACRO
	ld a, (player.yvelocity + 1)
	ld c, a
	rla
	sbc a
	ld b, a							; BC = top 16 bits of velocity.
	ENDM
