;
; Hardware register locations.
;

LINE:		EQU 249		; output: line to enable a CPU interrupt on, in range 0–191, or any other value to disable.
STATUS:		EQU 249		; input: b0: active low line interrupt pending; b1: mouse interrupt; b2: MIDI IN; b3: frame; b4: MIDI OUT; b5-b7: keyboard matrix lines 6-8.

LMPR:		EQU 250		; b0–b4: page control; b5: set to enable RAM in section A; b6: clear to enable RAM in section B; b7: write protect for section A.
HMPR:		EQU 251		; b0–b4: page control; b5-b6: bits 4 & 8 of the Mode 3 CLUT address; b7: use external memory.
VMPR:		EQU 252		; b0–b4: displayed page; b5-b6: graphics mode; b7: MIDI IN/OUT.
BORDER:		EQU 254		; output: b0–b2, b5: border colour; b3: MIC output; b4: BEEP output; b7: set to disable display in Modes 3 & 4.
KEYBOARD:	EQU 254		; input: b0-b4: keyboard matrix lines 1-5; b5: light pen strobe; b6: EAR input; b7: external memory status bit.

	; Keyboard reading is otherwise similar to the ZX Spectrum; use the high 8 bits of the port address to indicate which lines are active.

;
; Program defines.
;

VIDEOPAGE:	EQU 6 * 2


;
; Place this code just after where the frame buffer will be, in the upper page.
;
	ORG 0xe000
	DUMP VIDEOPAGE + 1, 8192
	AUTOEXEC

	; Disable display until setup is complete.
;	ld a, %10000000
;	out (BORDER), a


	; Disable interrupts.
	di

	;
	; Perform a paging dance to get this code into the right place by:
	;
	;	(1) paging this same code into the low page, and jumping to it; then
	;	(2) paging this code into its proper place in the upper quartile of the map, and jumping back to it.
	;
	; ... and set the expected video page and mode while at it.
	;
	ld a, VIDEOPAGE
	out (LMPR), a
	jp @low_target - 0x8000

@low_target:
	ld a, VIDEOPAGE
	out (HMPR), a
	or %01100000
	out (VMPR), a
	jp @finish_paging


	;
	; Set the desired video page.
	;
@finish_paging:
	; Set stack high.
	ld sp, 0

	; Disable display to speed setup.
	ld a, %10000000
	out (BORDER), a

	; Seed display.
	call setup_span_buffers

	; Reenable display.
	ld a, 0
	out (BORDER), a

	; TODO: establish palette. Reenable display (though it happens for free in the loop below at present)

;
; Loop indefinitely, flashing the border as a sign of life.
;
	ld a, 0
@endless_loop:
	push af
	call swap_span_buffer
	call clear_spans


	; Keep repainting complete line 3. To test the 'ends equal' path.
	ld a, %00100000
	out (LMPR), a

	ld l, 0
	ld a, (current_spans)
	add 7
	ld h, a

	pop af
	ld (hl), a

	out (BORDER), a
	inc a
	and 7
	jr @-endless_loop


;
; Differencing handler.
;
current_spans:	db 0

;
; Seeds the display and both span buffers to a clear state.
;
setup_span_buffers:
	;
	; Make the visible screen black.
	;
	ld e, 0x00
	ld hl, 0x8000
	ld bc, 128 * 192
@pixel_loop:
	ld (hl), e
	inc hl
	dec bc
	ld a, b
	or c
	jr nz, @-pixel_loop

	;
	; Fill both span buffers with blackness.
	;
	call clear_spans

	ld a, 0x40
	ld (current_spans), a
	jp clear_spans

;
; Clears the current back buffer.
;
clear_spans:
	; Reset the
	ld l, 0
	ld c, 10

@per_page:
	ld a, (current_spans)
	ld h, a

	ld a, %00100000
	add a, c
	out (LMPR), a

	ld b, 32
	@write_loop:
		ld (hl), 255
		inc h
		ld (hl), 0
		inc h
		djnz @-write_loop

	dec c
	dec c
	ret m
	jr @-per_page

;
; Promotes the current back buffer to the front and swaps the two over.
;
swap_span_buffer:
	;
	; Overarching register assignment:
	;
	;	D = line.
	;	E = offset within line.			[so that an `ex de, hl` can temporarily swap main pointers]
	;	BC = pointer to new spans.
	;	HL = pointer to old spans.		[for benefit of cp (hl)]
	;
	ld de, 0
	ld l, e
	ld c, e

	; Output.

	;
	; Lazy: I've unrolled per page here to avoid having to bother writing an outer loop.
	; Reevaluate this decision at some point.
	;
@page_loop: EQU for 6
page{@page_loop}:
	ld a, %00100000 + (@page_loop * 2)
	out (LMPR), a

	xor a
	ld l, a
	ld c, a

	ld a, (current_spans)
	ld b, a
	xor 0x40
	ld h, a

IF @page_loop == 5
	ld (current_spans), a
ENDIF

@compare_spans:
	ld a, (bc)
	cp (hl)

	jr z, @+same_ending
	jr c, @+hl_greater

	@bc_greater:
		; If here: (bc) was greater.
		; Paint to the end of (hl) if painting at all, and advance that pointer.

		; Compare colours.
		inc h
		inc b
		ld a, (bc)
		cp (hl)
		jr z, @+no_paint

		; IXh = colour.
		ld ixh, a

		; IYl = length.
		dec h
		ld a, (hl)
		inc h
		sub e
		ld iyl, a

		; Draw.
		call @fill_span

		@no_paint:
		dec h
		dec b

		; Update pixel location and advance HL. Leave BC alone.
		ld a, (hl)
		ld l, a
		ld e, a
		jr @-compare_spans

	@hl_greater:
		; If here: (hl) was greater.
		; Otherwise as above.

		; Compare colours.
		inc h
		inc b
		ld a, (bc)
		cp (hl)
		jr z, @+no_paint

		; IXh = colour.
		ld ixh, a

		; IYl = length.
		dec b
		ld a, (bc)
		inc b
		sub e
		ld iyl, a

		; Draw.
		call @fill_span

		@no_paint:
		dec h
		dec b

		; Update pixel location and advance BC. Leave HL alone.
		ld a, (bc)
		ld c, a
		ld e, a
		jr @-compare_spans

	@same_ending:
		; If here: (bc) == (hl), so both spans end in the same place.
		; Which opens up the possibility that line end will be reached.

		; Compare colours.
		inc h
		inc b
		ld a, (bc)
		cp (hl)
		jr z, @+no_paint

		; Set IXh = colour; IYl = width.
		ld ixh, a
		dec b
		ld a, (bc)
		inc b
		sub e
		ld iyl, a

		call @fill_span

		@no_paint:
		dec h
		dec b

		ld a, (bc)		; arbitrarily, could just as easily be (hl)
		ld c, a
		ld l, a
		ld e, a

		; Check whether that ended the line.
		inc a
		jr nz, @-compare_spans

	@next_line:
		inc h
		inc h
		inc b
		inc b

		xor a
		ld l, a
		ld e, a
		ld c, a

		inc d
		ld a, d
		and %11111

IF @page_loop == 5
		ret z
ELSE
		jr z, @+next_page
ENDIF

		jr @-compare_spans

	@next_page:
NEXT @page_loop


	;
	; Paint from d = y, e = x to x = IYl in colour IXh.
	;
	; Preserves HL, BC and D. Requires IYl >= 1.
	;
@fill_span:
	ex de, hl

	; Compute frame buffer address.
	scf
	rr h
	rr l

	jr nc, @+no_initial_right

	; Store low pixel of new colour.
	ld a, ixh
	and 0x0f
	ld ixl, a

	; Mutate current target of (HL) to include new pixel colour.
	ld a, (hl)
	and 0xf0
	or ixl
	ld (hl), a
	inc l

	; Decrement remaining pixel count, possibly exit.
	dec iyl
	jr z, @+finish_painting

	; To here: (HL) = aligned target address, IYl = number of pixels to paint; IXh = colour to paint.
	@no_initial_right:

		ld a, iyl
		srl a
		jr c, @+with_final_left

		call @+fill_bytes
		jr @+finish_painting

	@with_final_left:
		call @+fill_bytes

		ld a, ixh
		and 0xf0
		ld ixl, a

		ld a, (hl)
		and 0x0f
		or ixl

		ld (hl), a

	@finish_painting:
	rl l	; just to get the top bit into carry; low 7 don't really matter.
	rl h
	ex de, hl

@fill_bytes:
	; (HL) = aligned target address, A = number of bytes to paint; IXh = colour to paint.
	add a
	neg
	ld (@destination + 1), a

	ld a, ixh

	@destination:
		jp @+span_fill

ALIGN 256
@span_fill:
	@column: EQU FOR 128
	ld (hl), a
	inc l
	NEXT @column
	ret
