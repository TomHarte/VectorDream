;
; Hardware register locations.
;

CLUT:		EQU 248		; high byte of port address selects CLUT entry
LINE:		EQU 249		; output: line to enable a CPU interrupt on, in range 0–191, or any other value to disable.
STATUS:		EQU 249		; input: b0: active low line interrupt pending; b1: mouse interrupt; b2: MIDI IN; b3: frame; b4: MIDI OUT; b5-b7: keyboard matrix lines 6-8.

LMPR:		EQU 250		; b0–b4: page control; b5: set to enable RAM in section A; b6: clear to enable RAM in section B; b7: write protect for section A.
HMPR:		EQU 251		; b0–b4: page control; b5-b6: bits 4 & 8 of the Mode 3 CLUT address; b7: use external memory.
VMPR:		EQU 252		; b0–b4: displayed page; b5-b6: graphics mode; b7: MIDI IN/OUT.
BORDER:		EQU 254		; output: b0–b2, b5: border colour; b3: MIC output; b4: BEEP output; b7: set to disable display in Modes 3 & 4.
KEYBOARD:	EQU 254		; input: b0-b4: keyboard matrix lines 1-5; b5: light pen strobe; b6: EAR input; b7: external memory status bit.
	; Keyboard reading is otherwise similar to the ZX Spectrum; use the high 8 bits of the port address to indicate which lines are active.

HPEN:		EQU 504		; input: if no light-pen connected, current vertical scan position. Otherwise light-pen position.
LPEN:		EQU 504		; input: if no light-pen connected, current horizontal scan position. Otherwise light-pen position.



;
; Notes to future self on SP and interrupts:
;
;	It might actually be helpful to reuse SP as the pixel pointer when outputting spans.
;
;	In that case a new interrupt scheme might be: interrupt on line 191 of the display.
;
;	Upon interrupt, set last-observed HPEN as 192, and make sure it reaches that before
;	exiting.
;
;	Elsewhere, in span drawing, disable interrupts at the start and poll HPEN throughout.
;	If at any point HPEN is 192 and the last-observed HPEN isn't, manually call the interrupt
;	routine. Otherwise update the last-observed value as per observations.
;
;	I think that should leave the interrupt routine being a response to the actual interrupt
;	for most of the code, with the span code doing a manual call via polling only if it
;	has interrupts disabled when an interrupt should have been serviced.
;
;	Relevant observation is that HPEN seems to get to 192 and then stay there until it is
;	reset to 0 again at the top of the next frame. So it retains a value of 192 for a prolonged
;	120 lines, which should be spottable by periodic polling.
;
;	Annoyingly line interrupts can be scheduled only up to line 191, but hence why the interrupt
;	routine (at least if called from a real interrupt) either needs to be at least one line
;	long, which it probably is anyway, or else spin-poll on HPEN at the end to make sure it reads
;	192 before it exits.
;


;
; Notes to future self on memory map:
;
;	I think it would be valuable to switch this code around so that span buffers are accessed in
;	the high 32kb and code and screen sit in the low 32kb.
;
;	The main reason is that if I also switch to most code being on the spare 32kb bank and the only
;	thing sharing with the screen buffer being the span-update routine (in that case possibly severely
;	unrolled) then I can relocate the interrupt handler to 0x38 and dispense with the 257 byte
;	palindrome table.
;
;	A secondary is that it would save an SCF when span drawing. Which barely matters, but there it is.
;

;
; Program defines.
;

include "span_buffers/position.z80s"
PAGE.VIDEO:			EQU 0							; The page on which the framebuffer lies.
PAGE.FIRSTSPAN:		EQU 16 - spans.num_pages * 2	; The page on which the span buffer begins.

;
; Place this code just after where the frame buffer will be, in the upper half of memory.
;
	ORG 0xe000
	DUMP PAGE.VIDEO + 1, 8192

;
; Install various tables first, because they're all at least 256-byte aligned and this
; causes them to be tightly-packed.
;
include "road/aligned_tables.z80s"
include "maths/multiply_tables.z80s"
include "span_buffers/bss.z80s"
include "span_buffers/main.z80s"			; This breaks 256-byte alignment.
include "road/unaligned_tables.z80s"

;
; Code from here on:
;
include "span_buffers/span_buffers.z80s"	; Aligns to 256 bytes but doesn't maintain it.
include "span_buffers/overprint.z80s"
include "span_buffers/edges.z80s"
include "maths/multiply.z80s"
include "maths/divide.z80s"
include "road/road.z80s"
include "road/objects.z80s"
include "road/bss.z80s"


setup:
	ld a, %00100000 + PAGE.VIDEO + 2
	out (LMPR), a
	call player_setup

	jp road.setup


draw:
	call road.draw
	jp objects.draw


update:
	push bc
	call @+update
	pop bc
	djnz update

@update:
	; Read joystick/67890.
	ld bc, 0xeffe
	in a, (c)
	rra
	rra
	jr c, @+no_up

	ld hl, (player.yvelocity)
	ld de, 8
	add hl, de
	ld (player.yvelocity), hl

	@no_up:
	rra
	jr c, @+no_down

	ld hl, (player.yvelocity)
	ld de, -8
	add hl, de
	ld (player.yvelocity), hl

	@no_down:
	rra 
	jr c, @+no_right

	ld bc, -256
	ld (player.xvelocity), bc

	@no_right:
	rra
	jr c, @+no_left

	ld bc, 256
	ld (player.xvelocity), bc

	@no_left:

	; Read QW.
	ld bc, 0xfbfe
	in a, (c)
	rra
	jr c, @+no_q

	call road.curve_left

	ld hl, (curvature)
	ld bc, -7
	add hl, bc
	ld (curvature), hl

	jr @+no_w

	@no_q:
	rra
	jr c, @+no_w
	call road.curve_right

	ld hl, (curvature)
	ld bc, 7
	add hl, bc
	ld (curvature), hl

	@no_w:

	;
	; Y velocity.
	;

		; Apply.
		ld a, (player.y + 2)
		ld d, a
		ld hl, (player.y)					; D:HL = player,y

		ld a, (player.yvelocity + 1)
		rla
		sbc a
		ld bc, (player.yvelocity)			; A:BC = velocity, sign extended.

		add hl, bc
		adc d

		ld (player.y), hl
		ld (player.y + 2), a

		ld a, (player.yvelocity + 1)
		sra a

		; Dampen a little.
		ld b, 0x00
		ld c, a
		or a
		jp p, @+positive
		ld b, 0xff
		@positive:

		ld c, a
		ld hl, (player.yvelocity)
		or a
		sbc hl, bc
		ld (player.yvelocity), hl

	;
	; X velocity.
	;
		; Apply. With 8-bit arithmetic in order to catch overflow.
		ld bc, (player.xvelocity)
		ld hl, (player.x)
		ld a, c
		add l
		ld l, a
		ld a, b
		adc h
		ld h, a
		jp po, @+no_overflow

		or a
		sbc hl, bc

	@no_overflow:
		ld (player.x), hl

		; Dampen harshly.
		ld hl, (player.xvelocity)
		sra b
		rr c
		sra b
		rr c
		or a
		sbc hl, bc
		ld (player.xvelocity), hl

	ret

audio:
	in a, (LMPR)
	push af
	ld a, %00100000 + PAGE.VIDEO + 2
	out (LMPR), a

	; I've found no use for the alternate registers elsewhere in this code,
	; and player_play seems empirically to trash all of BC, DE and HL.
	;
	; So for now let it have the other register bank to itself.
	exx
	call player_play
	exx

	pop af
	out (LMPR), a

	ret

curvature: dw 0
player.x: dw 16 * 256
player.xvelocity: dw 0

player.y:
	db 0, 0, 0		; 16:8 fixed form.
player.yvelocity: dw 0

;
; Colour selections and palette.
;
border_colour:		EQU 0
tyre_colour:		EQU 0x00
sky_colour:			EQU 0x11
grass_colour1:		EQU 0x22
grass_colour2:		EQU 0x33
road_colour:		EQU 0x44
line_colour:		EQU 0x55
wood_colour:		EQU 0x66
leaf_colour:		EQU 0x77
warning_colour:		EQU 0x88
grass_colour_mix: 	EQU 0x99

racing_blue_colour:	EQU 0xaa
racing_red_colour:	EQU 0xbb

; Each colour is GRBXgrb where X = bright; G = high bit of green, g = low bit of green, etc.
; This list is OTIRd elsewhere, so is in reverse order.
palette:
	db 0, 0, 0, 0
	db 34			; racing car red
	db 16			; racing car blue
	db 65			; mixed-grass colour
	db %0101010		; bright red, for warning signage
	db %1101100		; yet another green, for trees
	db %1100010		; brown, for wood
	db %1110111		; line
	db %0000111		; road
	db 64			; grass 2 (the dimmer one, by convention)
	db 67			; grass 1
	db %0011000		; sky
	db %0000000		; screen border

;
; Interrupt routine sits at 0xfefe, so always include this last.
;
include "span_buffers/interrupt.z80s"

;
; Add music.
;

	ORG 0x0000
	DUMP PAGE.VIDEO + 2, 0

	MDAT "../binary/music.bin"

	player_setup: EQU 0
	player_play: EQU 7
