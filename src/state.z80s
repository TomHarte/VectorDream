curvature: dw 0

player.x: dw 0
player.xvelocity: dw 0

player.y:
	db 0x00, 0x00, 0x00		; 16:8 fixed form; little-endian.
player.yvelocity: dw 0

tyre.left_vibrate: db 0
tyre.right_vibrate: db 0

;
; State for non-player cars; I'm experimenting here, being unclear what's going
; to make for an acceptable solution.
;
cars.time_since_added: db 0			; Logic ticks since a car was last added.
cars.time_since_removed: db 0		; Logic ticks since a car was last removed.

