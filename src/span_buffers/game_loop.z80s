frame_counter: db 0

	AUTOEXEC

	; Disable both interrupts and display.
	di
	ld a, %10000000
	out (BORDER), a

	;
	; Get this code into the right place by paging it into the low page and jumping to it.
	; ... and set the expected video page and mode while at it.
	;
	ld a, PAGE.CODE + %00100000
	out (LMPR), a
	jp @low_target

@low_target:
	ld a, PAGE.VIDEO + %01100000
	out (VMPR), a

	; Set stack below dispatcher.
	ld sp, spans.swap.dispatch

	; Seed display.
	call spans.setup
	call setup

	; Establish palette.
	ld c, CLUT
	ld b, 0x10
	ld hl, palette
	otir

	; Seed pixels while display is off.
	call draw
	call spans.swap.dispatch

	; Reenable display.
	ld a, 0
	out (BORDER), a

	; Enable frame-counting interrupts, on line 191.
	ld a, 191
	out (LINE), a
	im 1
	ei

@game_loop:
	call draw
	call spans.swap.dispatch

	; Get B = number of frames since last did updates.
@get_frame_counter:
	xor a

	di
	ld bc, (frame_counter - 1)		; So B = count; C = [who cares?]
	ld (frame_counter), a
	ei

	; Spin until at least one frame has passed (this is optimistic!).
	ld a, b
	or a
	jr z, @-get_frame_counter

	call update
	jr @-game_loop
