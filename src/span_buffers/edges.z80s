;
; edge.fill.xx
;
; Applies a per-line fractional delta to a 16-bit integral position,
; clamps it into the range [0, 255] and writes out to an edge list.
;
; .upward fills from bottom to top — DE points to the lowest entry in the list,
; drawing proceeds upwards.
;
; .downward fills in the opposite direction — DE points to the highest entry in
; the list, drawing proceeds downwards.
;
; 	Input:
;		DE = pointer to list; this is the first entry that will be filled.
;		IXl = number of lines to write.
;		A:HL = first position to write in 16:8 (A = highest byte, L = lowest).
;		BC = per-line delta in 8:8.
;
; 	Output:
;		A:HL = position on the line above the final line written.
;		DE = pointer to first list entry that wasn't filled.
;
;	Clobbers:
;		A, IXl, IXh, HL, DE.
;
INC.L: EQU 0x2c
DEC.L: EQU 0x2d

edge.fill.downward:
	push af

	ld a, INC.L				; Opcode for INC L.
	ld (@+decrement), a
	jr @+edge.fill

edge.fill.upward:
	push af

	ld a, DEC.L				; Opcode for DEC L.
	ld (@+decrement), a

@edge.fill:
	; Sign extend BC so that IXh:BC = delta.
	ld a, b
	rla				; carry = sign bit
	sbc a, a		; a = a - a (- another bit, if sign was set)
	ld ixh, a

	; Potential TODO: branch from here into leftward or rightward fills,
	; to reduce cost of clamping if/when an edge goes off-screen.

	pop af

@output_line:
	; Clamp and write HL to (DE), decrementing the pointer.
	ex de, hl
	or a
	jr nz, @+write_clamped	; top byte != 0; write something clamped.

	ld (hl), d

@decrement:
	dec l
	ex de, hl

	; A:HL += IXh:BC.
	add hl, bc
	adc a, ixh

	; Some sort of optimisation to be made here:
	;
	;	*	if IXh:BC is positive and no carry into A, clearly the test above will give the same result for
	;		the next line.
	;	*	if IX:BC is negative andd there _is_ carry, same logic.
	;

	; Test for end of loop.
	dec ixl
	jr nz, @-output_line

	ret

@write_clamped:
	jp p, @+write_255	; top byte > 0; clamp to +255.

	ld (hl), 0x00		; top byte < 0; clamp to 0.
	jr @-decrement

@write_255:
	ld (hl), 0xff
	jr @-decrement

;
; TODO: this is less important to optimise than below, because it's kind of specific to the 2d cases
; where I'm clipping edges as I fill, but ideas:
;
;	*	check sign of B up front to divide into fill-rightward and fill-leftward;
;	*	if filling 'rightward' then if/when crossing 0xff, just fill from there as 0xff
;		(and similarly for leftward and 0x00).
;
; Plus potential unrollings, to reduce or eliminate the dec ixl, I guess. But, as above, this means
; of edge filling isn't what I intend to use in future projects necessarily.
;


;
; edges.output
;
; Outputs spans between whatever position is in edge.left and the corresponding
; position in edge.right.
;
; This fill proceeds _downward_.
;
; 	Input:
;		B = first line to output.
;		C = number of lines to output.
;		D = colour.
;
;	Clobbers:
;		A, C, DE, HL, IX, IYl.
;
edges.output:
	ld a, c			; Exit early if there are zero lines to draw.
	or a
	ret z

	ld ixh, d					; Stow colour.
	ld iyl, c					; Preserve loop counter.

	ld h, edge.left / 256
	ld l, b						; HL = left list pointer.

@page: EQU FOR spans.num_pages
	; Skip this page if not drawing on it.
	ld a, l
	cp (@page + 1) * 32
	jr nc, @+next_page		; First line of next page <= current drawing line,
							; so skip this page.

	; Install target span page.
	ld a, PAGE.FIRSTSPAN + (@page * 2)
	out (HMPR), a

	; Calculate pointer into span page.
	ld a, l
	rla
	and %00111110
	ld d, a
	ld a, (current_spans)
	add d
	ld d, a
	ld e, 0						; DE = pointer into spans.

@output_line:
	; Load B = left, C = right.
	ld b, (hl)
	inc h
	ld c, (hl)
	dec h
	inc l

	; Set up HL = pointer into span list.
	ex de, hl
	push de

	call spans.overprint.checkextent

	; Restore trashed values.
	pop de

	; Test 1: has C been exhausted?
	dec iyl
	ret z

	; Advance pointer into spans to start of next line.
	; Not actually necessary if the next section fails,
	; but hard to relocate.
	inc h
	ld l, 0
	ex de, hl

	; Test 2: is the page exhausted?
	ld a, d
	and %111110
	jr nz, @-output_line

@next_page:
	NEXT @page

 	ret

;
;
; Experiments in unrolling are below. Whether that's appropriate is an open question.
; The main advantage of unrolling is reduced register pressure.
;
;

; @page: EQU FOR spans.num_pages
; 	; TODO: dispatch code here.
; 	NEXT @page


; ;
; ; Assumption: outer wrapping will dynamically insert an exit
; ; into the code below.
; ;

; ;
; ; Option 1: two unrolled groups of 32, depending on current span page.
; ; Endpoint buffers are therefore dealt with dynamically.
; ;
; @line_group: EQU FOR 2
; IF @line_group == 0
; 	@line_base: EQU 0x8000
; ELSE
; 	@line_base: EQU 0x8000 ^ 0x4000
; ENDIF

; @lines_{@line_base}:
; @line: EQU FOR 32
; 	pop hl										; 1 byte

; 	;
; 	; Snake through memory, on even lines reading the left
; 	; pointer then the right and on odd lines reading the right
; 	; and then the left. This means that H doesn't have to be
; 	; both incremented and decremented on any single line.
; 	;
; IF @line & 1
; 	ld c, (hl)									; 1
; 	dec h										; 1
; 	ld b, (hl)									; 1
; ELSE
; 	ld b, (hl)									; 1
; 	inc h										; 1
; 	ld c, (hl)									; 1
; ENDIF

; 	inc l										; 1
; 	push hl										; 1	= 6 bytes / 12 accesses



; 	;
; 	; It feels wasteful that H is the thing that meaningfully survives
; 	; spans.overprint[.checkextent] but is the one thing this loop
; 	; always reloads. I don't think I can do better though. Stowing
; 	; it away in e.g. D would cost only an extra byte and avoid having
; 	; two sets of these 32 spans though, so is an option.
; 	;
; 	ld hl, (@line * 512) + @line_base			; 3 bytes / 3 accesses

; 	call spans.overprint.checkextent			; 3 / 5

; 												; = 12 / 20
; @skip_line:
; 	NEXT @line

; 	ret
; 	NEXT @line_group


	jr @+test1
@test1:

;
; Option 1: 192 lines unrolled [* 2?], for static endpoint reads, but dynamic
; treatment of the high byte of the span buffer.
;
@line: EQU FOR 192
	ld a, (edge.left + @line)			; 3 bytes / 4 accesses
	ld b, a								; 1 / 1
	ld a, (edge.right + @line)			; 3 / 4							; TODO: would it be faster to interleave these lists?
	ld c, a								; 1 / 1
																		;
																		; My instinct is no because that induces the need to deal with carry
																		; out of bit 7 when writing edges.

	IF @line & 31 == 0
		ld a, PAGE.FIRSTSPAN + (@page * 2)	; 2 / 2
		out (HMPR), a						; 2 / 3
		ld a, (current_spans)				; 3 / 4
		ld h, a								; 1 / 1
	ELSE
		inc h								; 1 / 1
	ENDIF

	ld l, 0								; 2 / 2
	call spans.overprint.checkextent	; 3 / 5

										; = 14 / 16		(or 22 bytes at every page start)

	; TODO: IF line & 31 == 31, establish next HMPR.

	NEXT @line

; 192 * 14 + 6 * (8 - 1) = 2,688 + 42 = 2,730
;
; So line n begins on n * 14 + floor(n / 32) * 7. Or it'd be a further 384 bytes for a dispatch table.
; Maybe an n/32 lookup table of six entries and an n&31 lookup table for 38 * 2 = 76 bytes total?
; Otherwise something more like an unrolled-and-slightly-modified multiplication:
;
;	(x & 1) ? 7 : 0 + (x & 2) ? 14 : 0 + ... + (x & 32) ? (32 * 14 + 6) : 0 + (x & 64) ? (64 * 12 + 6 * 2) : 0 ...
;
; Otherwise:
;
;	(x << 3) + (x << 2) + (x << 1) + ((x >> 5) << 1) + ((x >> 5) << 2)
;
;	i.e. if y = (x >> 5) + x
;		result = (x << 3) + (y << 2) + (y << 1)
;
;	[Do that twice and force a ret or a fixed exit jump on the second]

@test2:
	jr @-test2

;
; TODO: there's probably an unrolled solution to the above, and it'd be worth doing as this routine
; would also carry over into filled polygon 3d.
;
; Likely the stepping stones would be something like the following.
;
; Step 1:
;
;	*	unroll the inner part of 32 lines, with a computed jump to do any number
;		from 1 to 32 of them;
;	*	per page, set up HMPR, decide how many lines to do in total, do the fill call.
;
; This might allow IYl, at least, to go unused. Which would reduce stack activity elsewhere.
;
; Step 2:
;
;	*	provide a separate dispatcher per HMPR page, i.e. six of them, and externally jump
;		straight to the first of those that is relevant.
;
