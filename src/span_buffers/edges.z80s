;
; edge.fill.xx
;
; Applies a per-line fractional delta to a 16-bit integral position,
; clamps it into the range [0, 255] and writes out to an edge list.
;
; .upward fills from bottom to top — DE points to the lowest entry in the list,
; drawing proceeds upwards.
;
; .downward fills in the opposite direction — DE points to the highest entry in
; the list, drawing proceeds downwards.
;
; 	Input:
;		DE = pointer to list; this is the first entry that will be filled.
;		IXl = number of lines to write.
;		A:HL = first position to write in 16:8 (A = highest byte, L = lowest).
;		BC = per-line delta in 8:8.
;
; 	Output:
;		A:HL = position on the line above the final line written.
;		DE = pointer to first list entry that wasn't filled.
;
;	Clobbers:
;		A, IXl, IXh, HL, DE.
;
INC.L: EQU 0x2c
DEC.L: EQU 0x2d

edge.fill.downward:
	push af

	ld a, INC.L				; Opcode for DEC L.
	ld (@+decrement), a
	jr @+edge.fill

edge.fill.upward:
	push af

	ld a, DEC.L				; Opcode for DEC L.
	ld (@+decrement), a

@edge.fill:
	; Sign extend BC so that IXh:BC = delta.
	ld a, b
	rla				; carry = sign bit
	sbc a, a		; a = a - a (- another bit, if sign was set)
	ld ixh, a

	; Potential TODO: branch from here into leftward or rightward fills,
	; to reduce cost of clamping if/when an edge goes off-screen.

	pop af

@output_line:
	; Clamp and write HL to (DE), decrementing the pointer.
	ex de, hl
	or a
	jr z, @+write_d		; top byte = 0; write integral part.
	jp p, @+write_255	; top byte > 0; clamp to +255.

	ld (hl), 0x00		; top byte < 0; clamp to 0.
	jr @+decrement

@write_255:
	ld (hl), 0xff
	jr @+decrement

@write_d:
	ld (hl), d

@decrement:
	dec l
	ex de, hl

	; A:HL += IXh:BC.
	add hl, bc
	adc a, ixh

	; Some sort of optimisation to be made here:
	;
	;	*	if IXh:BC is positive and no carry into A, clearly the test above will give the same result for
	;		the next line.
	;	*	if IX:BC is negative andd there _is_ carry, same logic.
	;

	; Test for end of loop.
	dec ixl
	jr nz, @-output_line

	ret


;
; TODO: this is less important to optimise than below, because it's kind of specific to the 2d cases
; where I'm clipping edges as I fill, but ideas:
;
;	*	check sign of B up front to divide into fill-rightward and fill-leftward;
;	*	if filling 'rightward' then if/when crossing 0xff, just fill from there as 0xff
;		(and similarly for leftward and 0x00).
;
; Plus potential unrollings, to reduce or eliminate the dec ixl, I guess. But, as above, this means
; of edge filling isn't what I intend to use in future projects necessarily.
;


;
; edges.output
;
; Outputs spans between whatever position is in edge.left and the corresponding
; position in edge.right.
;
; This fill proceeds _downward_.
;
; 	Input:
;		B = first line to output.
;		C = number of lines to output.
;		D = colour.
;
;	Clobbers:
;		A, C, DE, HL, IX, IYl.
;
edges.output:
	ld a, c			; Exit early if there are zero lines to draw.
	or a
	ret z

	ld ixh, d					; Stow colour.
	ld iyl, c					; Preserve loop counter.

	ld h, edge.left / 256
	ld l, b						; HL = left list pointer.

@page: EQU FOR spans.num_pages
	; Skip this page if not drawing on it.
	ld a, l
	cp (@page + 1) * 32
	jr nc, @+next_page		; First line of next page <= current drawing line,
							; so skip this page.

	; Install target span page.
	ld a, PAGE.FIRSTSPAN + (@page * 2)
	out (HMPR), a

	; Calculate pointer into span page.
	ld a, l
	rla
	and %00111110
	ld d, a
	ld a, (current_spans)
	add d
	ld d, a
	ld e, 0						; DE = pointer into spans.

@output_line:
	; Load B = left, C = right.
	ld b, (hl)
	inc h
	ld c, (hl)
	dec h
	inc l

	; Set up HL = pointer into span list.
	ex de, hl
	push de

	ld d, ixh
	call spans.overprint.checkextent

	; Restore trashed values.
	pop de

	; Test 1: has C been exhausted?
	dec iyl
	ret z

	; Advance pointer into spans to start of next line.
	; Not actually necessary if the next section fails,
	; but hard to relocate.
	inc h
	ld l, 0
	ex de, hl

	; Test 2: is the page exhausted?
	ld a, d
	and %111110
	jr nz, @-output_line

@next_page:
	NEXT @page

 	ret

;
; TODO: there's probably an unrolled solution to the above, and it'd be worth doing as this routine
; would also carry over into filled polygon 3d.
;
; Probably the stepping stones would be something like the following.
;
; Step 1:
;
;	*	unroll the inner part of 32 lines, probably with a computed jump to do any number
;		from 1 to 32 of them;
;	*	per page, set up HMPR, decide how many lines to do in total, do the fill call.
;
; This might allow IYl, at least, to go unused. Which would reduce stack activity elsewhere.
;
; Step 2:
;
;	*	provide a separate dispatcher per HMPR page, i.e. six of them, and externally jump
;		straight to the first of those that is relevant.
;
