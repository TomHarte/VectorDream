; 	ld h, edge_list_left / 256
; 	ld l, b
; 	ld d, edge_list_right / 256
; 	ld e, b						; HL = left list pointer; DE = right list pointer.

; 	; ... and D still equals colour.

; 	ld a, b
; 	rlca
; 	rlca
; 	rlca
; 	and 7		; Get first page touched.

; @span_page: EQU FOR 6

