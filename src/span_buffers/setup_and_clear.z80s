
;
; spans.setup
;
; Seeds the pixel display and both span buffers to a consistent, clear state.
; Required at program startup.
;
;	Input:
; 		none.
;
;	Output:
;		none.
;
;	Clobbers:
;		A, BC, E, HL.
;
spans.setup:
	;
	; Make the visible screen black.
	;
	ld a, PAGE.VIDEO
	out (HMPR), a
	ld hl, 0x8000
	ld de, 0x8001
	ld bc, 128 * 192 - 1
	ld (hl), 0x00
	ldir

	;
	; Seed initial span location.
	;
	ld a, 0x80
	ld (current_spans), a

	;
	; Fill both span buffers with blackness.
	;
	call spans.clear

	ld a, (current_spans)
	xor 0x40
	ld (current_spans), a

	; Fallthrough to spans.clear. Eliminating:
	;
	;	jp spans.clear

;
; spans.clear
;
; Clears the current buffer. This is completely optional; if you have a routine that will completely overwrite
; it anyway, there's no need to call this.
;
;	Input:
; 		none.
;
;	Output:
;		none.
;
;	Clobbers:
;		A, BC, HL.
;
spans.clear:
	ld l, 0
	ld c, 10

@per_page:
	ld a, (current_spans)
	ld h, a

	ld a, PAGE.FIRSTSPAN
	add a, c
	out (HMPR), a

	ld b, 32
	@write_loop:
		ld (hl), 255
		inc h
		ld (hl), 0
		inc h
		djnz @-write_loop

	dec c
	dec c
	ret m
	jr @-per_page
