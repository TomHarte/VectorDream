;
; Manages a double-buffered 'span buffer', i.e. a buffer that stores continuous solid horiontal spans of colour.
;
; It can do differential drawing — comparing a new buffer to an old one and outputting only the differences.
;
; It therefore seeks to ameliorate for the SAM's speed vs framebuffer deficit for scenes that:
;	(i) can be described well as horizontal strips of colour; and
;	(ii) that do not change 'too much' from one frame to the next.
;
; It uses memory pages 0–5 inclusive for these span buffers and assumes itself to have been assembled onto the same
; page as a video buffer that it can use for pixel plotting, and paged into the top half of the memory map. It will
; freely adjust what is paged in the low half of the memory map.
;
; Exported symbols:
;
;	* `spans.setup` should be called once at program startup;
;	* `spans.clear` can be used to populate the current back buffer with a black screen;
;	* `spans.swap` swaps the front and back span buffers, updating the pixel display; and
;	* `spans.getaddress` which pages the proper buffer and returns a pointer to the start of a named line.
;


ALIGN 256
@span_fill:
	@column: EQU FOR 128
	ld (de), a
	inc e
	NEXT @column
	jp (ix)

;
; spans.swap
;
; Swaps the front and back buffers, updating current pixel output.
;
; Implementation choice: optimise for buffers with very few differences; hence prioritise navigation of the lists
; in terms of register allocation, and don't try to be clever with the stack pointer in span drawing on the assumption
; that they'll generally be short.
;
;	Input:
; 		none.
;
;	Output:
;		none.
;
;	Clobbers:
;		A, BC, DE, HL, IX, IYl.
;

current_spans_swap: db 0
@sp_backup: dw 0
@hpen: db 0

spans.swap:
	; Establish canonical value of SP.
	ld (@sp_backup), sp

	; Store current line for upcoming interrupt checks.
	ld bc, HPEN
	in a, (c)
	ld (@hpen), a

	;
	; Overarching register assignment:
	;
	;	D = line on screen.
	;	E = offset within line.
	;	BC = pointer to new spans.
	;	HL = pointer to old spans.		[for benefit of cp (hl)]
	;
	ld de, spans.output_y * 256
	ld l, e		; H and B will be loaded at the start of the per-page output.
	ld c, e

	; Output.

@page: EQU for spans.num_pages
	; Page in proper source and destination buffers.
	ld a, PAGE.FIRSTSPAN + (@page * 2)
	out (HMPR), a

	; Reset B and H parts of BC and HL to start of page.
	ld a, (current_spans_swap)
	ld b, a
	xor 0x40
	ld h, a

IF @page == spans.num_pages - 1
	ld (current_spans_swap), a
ENDIF

@compare_spans:
	;
	; INITIAL DISPATCH. Compare endpoints of the current spans.
	; From here onwards there's a tail dispatch for each of the cases.
	;
	ld a, (bc)
	cp (hl)

	jr z, @+same_ending
	jr c, @+hl_greater

	@bc_greater:
		; If here: (bc) was greater, i.e. (bc) span ends later than (hl).
		; So advance to the end of (hl), painting if necessary, and advance that pointer.

		; Compare colours.
		inc h
		inc b
		ld a, (bc)
		cp (hl)
		jr z, @+no_paint

		; A = length.
		dec h
		ld a, (hl)
		inc h
		sub e

		; Draw.
		ld iy, @no_paint
		jp @fill_span

		@no_paint:
		dec h
		dec b

		; Update pixel location and advance HL. Leave BC alone.
		ld a, (hl)
		ld l, a
		ld e, a

		;
		; TAIL DISPATCH.
		;
		ld a, (bc)
		cp (hl)

		jr z, @+same_ending
		jr nc, @-bc_greater

	@hl_greater:
		; If here: (hl) was greater.
		; Otherwise as above.

		; Compare colours.
		inc h
		inc b
		ld a, (bc)
		cp (hl)
		jr z, @+no_paint

		; A = length.
		dec b
		ld a, (bc)
		inc b
		sub e

		; Draw.
		ld iy, @no_paint
		jp @fill_span

		@no_paint:
		dec h
		dec b

		; Update pixel location and advance BC. Leave HL alone.
		ld a, (bc)
		ld c, a
		ld e, a

		;
		; TAIL DISPATCH.
		;
		ld a, (bc)
		cp (hl)

		jr c, @-hl_greater
		jr nz, @-bc_greater

	@same_ending:
		; If here: (bc) == (hl), so both spans end in the same place.
		; Which opens up the possibility that line end will be reached.

		; Compare colours.
		inc h
		inc b
		ld a, (bc)
		cp (hl)
		jr nz, @+paint

	@same_ending_tail:
		dec h
		dec b

		ld a, (bc)		; arbitrarily, could just as easily be (hl)
		ld l, a
		ld e, a
		ld c, a

		; Check whether that ended the line.
		inc a
		jr z, @+next_line			; Slightly convoluted control flow follows, to try to reserve the fast path
									; for the nothing-to-draw case.

		;
		; TAIL DISPATCH.
		;
		ld a, (bc)
		cp (hl)

		jr z, @-same_ending
		jr c, @-hl_greater
		jr @-bc_greater

	@paint:
		; Set A = width; ensure (BC) still points to the output colour.
		dec b
		ld a, (bc)
		inc b
		sub e

		ld iy, @-same_ending_tail
		jp @fill_span

	@next_line:
		; Advance high part of span pointers.
		inc h
		inc h
		inc b
		inc b

		; Reset low part of span pointers and pixel x position.
		xor a
		ld l, a
		ld e, a
		ld c, a

		; Increment pixel y position and check whether it's time to roll into the next page.
		inc d
		ld a, d
		and %11111

		jr nz, @-compare_spans

		; At end of each page of lines, check for a potential missed interrupt.
		ld a, (@-hpen)
		ld l, a				; L = old HPEN.

		ld bc, HPEN
		in a, (c)
		ld (@-hpen), a		; A = stored value = new HPEN.

		cp 192
		jr nz, @+not_new_192

		ld sp, (@sp_backup)
		cp l
		call nz, count_time.dispatch

	@not_new_192:
		; Restore BC and L.
		xor a
		ld c, a
		ld l, a
		ld a, h
		xor 0x40
		ld b, a

	NEXT @page

		ld sp, (@sp_backup)
		ret

	;
	; Paint from d = y, e = x for width = A pixels, in colour (BC).
	; Upon compeletion, jump to address in IY.
	;
	; Preserves HL, BC and D. Requires A >= 1.
	; Assumes H = B ^ 0x40.
	;
@fill_span:
	; Compute frame buffer address.
	srl d
	rr e

	jr nc, @+no_initial_right

		; Store width away somewhere.
		ld (@+reload_width + 1), a

		; Store low pixel of new colour.
		ld a, (bc)
		and 0x0f
		ld h, a

		; Mutate current target of (HL) to include new pixel colour.
		ld a, (de)
		and 0xf0
		or h
		ld (de), a
		inc e

		; Decrement remaining pixel count, possibly exit.
	@reload_width:
		ld a, 0
		dec a
		jr z, @+finish_painting

	; To here: (HL) = aligned target address, A = number of pixels to paint; (BC) = colour to paint.
	@no_initial_right:
		srl a
		jr c, @+with_final_left

		ld ix, @finish_painting
		jp @fill_bytes

	@with_final_left:
		jr z, @+no_fill_bytes
		ld ix, @no_fill_bytes
		jp @fill_bytes

	@no_fill_bytes:
		ld a, (bc)
		and 0xf0
		ld h, a

		ld a, (de)
		and 0x0f
		or h

		ld (de), a

	@finish_painting:
		rl e		; Just to get the top bit into carry; low 7 don't really matter.
		rl d

		ld a, b		; Restore correct value of H, which was possibly lost.
		xor 0x40
		ld h, a

		jp (iy)

;
; fill_bytes
;
; Does the equivalent of a C memset, for buffers between 1 and 128 bytes in size.
; Increments only the low byte of the pointer after each byte, so requires buffer alignment.
; Upon completion, jumps to IX.
;
;	Input:
; 		DE = address of first byte to write.
;		A = number of bytes to write.
;		(BC) = value to write.
;		IX = destination to return to after bytes have been filled.
;
;	Output:
;		DE = (address of final written byte) + 1.
;
;	Clobbers:
;		A.
;
@fill_bytes:
	add a							; 4 / 8
	neg								; 8 / 16
	ld (@destination + 1), a		; 16 / 32

	ld a, (bc)						; 8 / 16

@destination:
	jp @-span_fill					; 12 / 24

									; = 48 / 96

;
; Note to future self:
;
; It'd be fantastic to be able to dispatch to stack-blasting routines
; if/when the number of bytes to write crosses the threshold that will
; pay for manual BC manipulation and SP setup.
;
; Code below plays around with costs/benefits of that as an idea.
;

;
; Table-based dispatch:
;
;	exx		(bringing in fixed h)	4
;	ld l, a							4
;	ld e, (hl)						8
;	inc h							4
;	ld d, (hl)						8
;	dec h							4
;	ex de, hl						4
;	jp (hl)							4
;
;	...
;	ex de, hl						4
;	exx								4	= 48 (!?!)
;	...
;
; So table-based dispatch is a wash?
;

;
; Regular filling:
;
;	ld (bc), a
;	inc c
;
;	=> bytes * 12 / 24
;


;
; Stack-blasted filling (if I can carry BC over the exx line?):
;
;	ld hl, [length]			; 12 / 24
;	add hl, bc				; 12 / 16	= 24 / 40
;	ld sp, hl				; 4 / 8
;	ld c, a					; 4 / 8
;	ld b, a					; 4 / 8
;
;	[bytes / 2] * 12 / 24
;
; So this gets ahead as soon as setup < bytes * 12/24 ?
; i.e. ~ 36 < bytes * 12 => bytes >= 3
;
;	... that's **really** low. Probably misleading as I'm ignoring the
;	costs of dealing with odd byte counts and of somehow carrying BC
;	over the divide and updating it back on the other side?
;
;	Odd lengths are probably an extra exx / ld (bc), a / inc c / exx ?
;	So 20 / 40?
;
;	Not sure about how to carry BC across the EXX divide in both
;	directions cheaply. It's 16/32 to move BC to IX or IY and then
;	back again. Cheaper than loading into memory somewhere.
;
;	So potential ignored costs on dispatch are:
;
;		20 + 16 = 36-ish. Plus existing 36 = 72;
;
;		Then bytes >= 6? 4 doesn't quite make the cut even at only 56 overhead,
;		5 incurs an odd penalty. 6 seems to break even.
;
;
; Addendum: 8-bit arithmetic will do, won't it?
;
;	ld h, b					; 4
;	ld a, [length]			; 8
;	add a, c				; 4
;	ld l, c					; 4 = 20 / 40
;
;

;
; Conclusion: definitely worth trying.
; Will need to stop using the alternate registers for HPEN tracking though.
;
