MAX_FILL_LENGTH: EQU 127		; Maximum number of bytes that will be purely written, not read-modify-written.
								; This is only 127 since the display is only 255 pixels wide.

ALIGN 256
@write_target:
	dw 0
	@target: EQU FOR MAX_FILL_LENGTH
	dw @write_{@target + 1}_bytes
	NEXT @target

current_spans_swap: db 0
@sp_backup: dw 0
@hpen: db 0

;
; spans.swap
;
; Swaps the front and back buffers, updating current pixel output.
;
; Implementation choice: optimise for buffers with very few differences; hence prioritise navigation of the lists
; in terms of register allocation, and don't try to be clever with the stack pointer in span drawing on the assumption
; that they'll generally be short.
;
;	Input:
; 		none.
;
;	Output:
;		none.
;
;	Clobbers:
;		A, BC, DE, HL, BC', DE', HL', IX, IY.
;
spans.swap:
	; Establish canonical value of SP.
	ld (@sp_backup), sp

	; Store current line for upcoming interrupt checks.
	ld bc, HPEN
	in a, (c)
	ld (@hpen), a

	; Establish top byte of span-filler jump table in the shadow H;
	; it'll be assumed to present later during dispatch.
	exx
	ld h, @write_target / 256
	exx

	;
	; Overarching register assignment:
	;
	;	D = line on screen.
	;	E = offset within line.
	;	BC = pointer to new spans.
	;	HL = pointer to old spans.		[for benefit of cp (hl)]
	;
	ld de, spans.output_y * 256
	ld l, e		; H and B will be loaded at the start of the per-page output.
	ld c, e

	; Output.

@page: EQU for spans.num_pages
	; Page in proper source and destination buffers.
	ld a, PAGE.FIRSTSPAN + (@page * 2)
	out (HMPR), a

	; Reset B and H parts of BC and HL to start of page.
	ld a, (current_spans_swap)
	ld b, a
	xor 0x40
	ld h, a

IF @page == spans.num_pages - 1
	ld (current_spans_swap), a
ENDIF

@compare_spans:
	;
	; INITIAL DISPATCH. Compare endpoints of the current spans.
	; From here onwards there's a tail dispatch for each of the cases.
	;
	ld a, (bc)
	cp (hl)

	jr z, @+same_ending
	jr c, @+hl_greater

	@bc_greater:
		; If here: (bc) was greater, i.e. (bc) span ends later than (hl).
		; So advance to the end of (hl), painting if necessary, and advance that pointer.

		; Compare colours.
		inc h
		inc b
		ld a, (bc)
		cp (hl)
		jr z, @+no_paint

		; A = length.
		dec h
		ld a, (hl)
		inc h
		sub e

		; Draw.
		ld iy, @no_paint
		jp @fill_span

		@no_paint:
		dec h
		dec b

		; Update pixel location and advance HL. Leave BC alone.
		ld a, (hl)
		ld l, a
		ld e, a

		;
		; TAIL DISPATCH.
		;
		ld a, (bc)
		cp (hl)

		jr z, @+same_ending
		jr nc, @-bc_greater

	@hl_greater:
		; If here: (hl) was greater.
		; Otherwise as above.

		; Compare colours.
		inc h
		inc b
		ld a, (bc)
		cp (hl)
		jr z, @+no_paint

		; A = length.
		dec b
		ld a, (bc)
		inc b
		sub e

		; Draw.
		ld iy, @no_paint
		jp @fill_span

		@no_paint:
		dec h
		dec b

		; Update pixel location and advance BC. Leave HL alone.
		ld a, (bc)
		ld c, a
		ld e, a

		;
		; TAIL DISPATCH.
		;
		ld a, (bc)
		cp (hl)

		jr c, @-hl_greater
		jr nz, @-bc_greater

	@same_ending:
		; If here: (bc) == (hl), so both spans end in the same place.
		; Which opens up the possibility that line end will be reached.

		; Compare colours.
		inc h
		inc b
		ld a, (bc)
		cp (hl)
		jr nz, @+paint

	@same_ending_tail:
		dec h
		dec b

		ld a, (bc)		; arbitrarily, could just as easily be (hl)
		ld l, a
		ld e, a
		ld c, a

		; Check whether that ended the line.
		inc a
		jr z, @+next_line			; Slightly convoluted control flow follows, to try to reserve the fast path
									; for the nothing-to-draw case.

		;
		; TAIL DISPATCH.
		;
		ld a, (bc)
		cp (hl)

		jr z, @-same_ending
		jr c, @-hl_greater
		jr @-bc_greater

	@paint:
		; Set A = width; ensure (BC) still points to the output colour.
		dec b
		ld a, (bc)
		inc b
		sub e

		ld iy, @-same_ending_tail
		jp @fill_span

	@next_line:
		; Advance high part of span pointers.
		inc h
		inc h
		inc b
		inc b

		; Reset low part of span pointers and pixel x position.
		xor a
		ld l, a
		ld e, a
		ld c, a

		; Increment pixel y position and check whether it's time to roll into the next page.
		inc d
		ld a, d
		and %11111

		jr nz, @-compare_spans

		; At end of each page of lines, check for a potential missed interrupt.
		ld a, (@-hpen)
		ld l, a				; L = old HPEN.

		ld bc, HPEN
		in a, (c)
		ld (@-hpen), a		; A = stored value = new HPEN.

		cp 192
		jr nz, @+not_new_192

		ld sp, (@sp_backup)
		cp l
		call nz, count_time.dispatch

	@not_new_192:
		; Restore BC and L.
		xor a
		ld c, a
		ld l, a
		ld a, h
		xor 0x40
		ld b, a

	NEXT @page

		ld sp, (@sp_backup)
		ret

	;
	; Paint from d = y, e = x for width = A pixels, in colour (BC).
	; Upon compeletion, jump to address in IY.
	;
	; Preserves HL, BC and D. Requires A >= 1.
	; Assumes H = B ^ 0x40.
	;
@fill_span:
	; Compute frame buffer address.
	srl d
	rr e

	jr nc, @+no_initial_right

		; Store width away somewhere.
		ld (@+reload_width + 1), a

		; Store low pixel of new colour.
		ld a, (bc)
		and 0x0f
		ld h, a

		; Mutate current target of (HL) to include new pixel colour.
		ld a, (de)
		and 0xf0
		or h
		ld (de), a
		inc e

		; Decrement remaining pixel count, possibly exit.
	@reload_width:
		ld a, 0
		dec a
		jr z, @+finish_painting

	; To here: (HL) = aligned target address, A = number of pixels to paint, (BC) = colour to paint.
	@no_initial_right:
		srl a
		jr c, @+with_final_left

		ld ix, @finish_painting
		jp @fill_bytes

	@with_final_left:
		jr z, @+no_fill_bytes
		ld ix, @no_fill_bytes
		jp @fill_bytes

	@no_fill_bytes:
		ld a, (bc)
		and 0xf0
		ld h, a

		ld a, (de)
		and 0x0f
		or h

		ld (de), a

	@finish_painting:
		rl e		; Just to get the top bit into carry; low 7 don't really matter.
		rl d

		ld a, b		; Restore correct value of H, which was possibly lost.
		xor 0x40
		ld h, a

		jp (iy)

;
; fill_bytes
;
; Does the equivalent of a C memset, for buffers between 1 and 128 bytes in size.
; Increments only the low byte of the pointer after each byte, so requires buffer alignment.
; Upon completion, jumps to IX.
;
;	Input:
; 		DE = address of first byte to write.
;		A = number of bytes to write.
;		(BC) = value to write.
;		IX = destination to return to after bytes have been filled.
;
;	Output:
;		DE = (address of final written byte) + 1.
;
;	Clobbers:
;		A.
;
@fill_bytes:
	exx				; 4		; Brings in H = pointer to dispatch table.

	add a, a		; 4		; A is strictly less than 128, so this definitely fits.
	ld l, a			; 4

	ld e, (hl)		; 8
	inc l			; 4
	ld d, (hl)		; 8
	ex de, hl		; 4

	jp (hl)			; 4

		; [plus an implied 8 at the receiver] = 48 cycles dispatch

		; In an older approach, non-stack-blasting drawing was assumed with a dispatch that looked like:
		;
		;	add a, a						; 4
		;	neg								; 4
		;	ld (jump + 1), a				; 16
		;	@jump: jp dest					; 12		= 36

;
; Routines to write n bytes; all @fill_bytes actually does is a dispatch.
;
; Heavily coupled to @fill_bytes though, so:
;
;	* at entry, the shadow registers will be visible and the value assumed ordinarily to be in H will be in D;
;	* BC in the non-shadow registers points to the colour to output;
;	* at exit non-shadow DE needs to have been advanced by the number of bytes being output, and the non-shadow registers need to be visible; and
;	* the appropriate continuation address is in IX.
;
; A and SP are free for use, as are the shadow BC, E and HL. As above, the shadow D needs to end up in the shadow H.
;
@write_span: EQU FOR MAX_FILL_LENGTH
	@num_bytes: EQU @write_span + 1

	@write_{@num_bytes}_bytes:

	ex de, hl
	exx					; Restore shadow registers to an appropriate state for the next
						; dispatch and return to the main registers.

	;
	; Costs:
	;
	;	Non-stack: 8 + 12 * bytes.
	;	Even: 52 + 6 * bytes.
	;	Odd: 68 + 6 * (bytes - 1)	= 62 + 6 * bytes
	;
	; So the correct thresholds are:
	;
	; 		52 + 6b < 8 + 12b			[even spans]
	; =>	44 < 6b
	; =>	7.333 <= b		(so 8 is the first even length faster to plot)
	;
	;		62 + 6b < 8 + 12b			[odd spans]
	; =>	56 < 6b
	; =>	9.333 <= b		(so 11 is the first odd length faster to plot)
	;
	@threshold: EQU 8 + (@num_bytes & 1) * 3
	IF @num_bytes < @threshold
		;
		; Short spans: write the requested number of bytes via DE,
		; incrementing along.
		;

		ld a, (bc)			; Load colour to fill with.

		@write_bc: EQU FOR @num_bytes
			ld (de), a
			inc e					; 12 * bytes
		NEXT @write_bc

	ELSE

		IF @num_bytes & 1

			; If an odd number of bytes, put one out directly via DE.

			ld a, (bc)				; 8
			ld (de), a				; 8			; Get colour into A and write the first byte.

		ENDIF

		ld a, @num_bytes		; 8
		add e					; 4
		ld e, a					; 4			; Advance DE to its correct ending point.

		ex de, hl				; 4
		ld sp, hl				; 4
		ex de, hl				; 4			; Load DE into SP.

		ld a, (bc)				; 8			; Obtain the colour.

		exx						; 4
		ld b, a					; 4
		ld c, a					; 4			; Duplicate the colour into BC'.

		;
		; Write the proper quantity of bytes.
		;

		@push_bc: EQU FOR @num_bytes / 2
			push bc				; 6 * bytes
		NEXT @push_bc

		exx						; 4			; Switch back to the main register set.

	ENDIF

	jp (ix)

	NEXT @write_span

;
; Ensure that actually fitted onto the video page.
;
@end_marker:
;	jr @-end_marker
	ASSERT @end_marker < 0x8000
