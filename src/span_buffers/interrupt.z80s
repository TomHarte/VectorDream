;
; Interrupt handler. Counts frames, for frame-rate compensation,
; and offers a call-out for audio updates.
;

DUMP PAGE.CODE, 0x38
ORG 0x38

;
; This assumes AF' is unused elsewhere. Which it currently is.
;
interrupt:
	ex af, af'

	in a, (STATUS)
	rra
	call nc, count_time

	ex af, af'
	ei
	reti

count_time:
	ld a, (frame_counter)
	inc a
	ld (frame_counter), a

	call update_audio

	ret
