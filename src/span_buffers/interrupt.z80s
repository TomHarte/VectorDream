;
; Interrupt handler. Just counts frames, for frame-rate compensation.
; Probably TODO: add music player from here.
;
; TODO: is this really part of 'span_buffers'?
;

interrupt: EQU 0x7f7f

ORG interrupt
DUMP PAGE.VIDEO + 1, interrupt & 16383

;
; This assumes AF' is unused elsewhere. Which it currently is.
;
interrupt:
	ex af, af'
	in a, (STATUS)
	and 8
	jr nz, @+not_end_of_frame

	ld a, (frame_counter)
	inc a
	ld (frame_counter), a

;	call audio

@not_end_of_frame:
	ex af, af'
	ei
	reti
