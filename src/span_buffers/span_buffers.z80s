
;
; spans.setup
;
; Seeds the pixel display and both span buffers to a consistent, clear state.
; Required at program startup.
;
;	Input:
; 		none.
;
;	Output:
;		none.
;
;	Clobbers:
;		A, BC, E, HL.
;
spans.setup:
	;
	; Make the visible screen black.
	;
;	ld hl, 0x0000
;	ld de, 0x0001
;	ld bc, 128 * 192 - 1
;	ld (hl), 0x00
;	ldir

	;
	; Fill both span buffers with blackness.
	;
	call spans.clear

	ld a, (current_spans)
	xor 0x40
	ld (current_spans), a

	; Fallthrough to spans.clear. Eliminating:
	;
	;	jp spans.clear

;
; spans.clear
;
; Clears the current buffer. This is completely optional; if you have a routine that will completely overwrite
; it anyway, there's no need to call this.
;
;	Input:
; 		none.
;
;	Output:
;		none.
;
;	Clobbers:
;		A, BC, HL.
;
spans.clear:
	ld l, 0
	ld c, 10

@per_page:
	ld a, (current_spans)
	ld h, a

	ld a, PAGE.FIRSTSPAN
	add a, c
	out (HMPR), a

	ld b, 32
	@write_loop:
		ld (hl), 255
		inc h
		ld (hl), 0
		inc h
		djnz @-write_loop

	dec c
	dec c
	ret m
	jr @-per_page

;
;	spans.getaddress
;
;	Obtains a pointer to the start of a line in the current span back buffer.
;
;	Input:
; 		A = line to prepare.
;
;	Output:
;		proper block of lines has been paged; HL = pointer to start of line.
;
;	Clobbers:
;		A.
;
spans.getaddress:
	; For line with bit pattern abcdefgh:
	;
	;	* the required HMPR value is: 0000abc0;
	;	* L is 0; and
	;	* H is current_spans + defgh * 2.

	; Keep all of A in H to mask off the low portion shortly...
	ld h, a

	rra
	rra
	rra
	rra
	and %00001110
	add PAGE.FIRSTSPAN
	out (HMPR), a

	ld a, h
	rla
	and %00111110
	ld h, a
	ld a, (current_spans)
	add h
	ld h, a
	ld l, 0

	ret
