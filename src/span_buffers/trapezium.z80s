;
; trapezium
;
; Overprints a trapezium with x-axis-aligned top and bottom. This code draws bottom-up;
; the 'initial' left and right coordinates are for the _bottom_ of the trapezium.
;
;	Input:
;		HL = initial left edge (integral; 0–255 = on-screen, other values = off)
;		BC = left edge delta — amount to add to the left edge per line (8.8 fixed point)
;		HL' = initial right edge;
;		BC' = initiel right edge delta;
;		D = start y;
;		E = end y;
;		A = colour.
;
;	Requires:
;		D < E.
;		0 <= D, E < 192.
;		Edges do not cross.
;
;	Output:
;		Modifies the current span list to include the described trapezium.
;
;	Clobbers:
;		BC, BC', DE, DE', HL, HL', IX, IY, A.
;
trapezium:

	; Due to register pressure, I've chickened out and decided to use an
	; intermediate buffer for start and endpoints. On the plus side, having a
	; single "draw what is in the buffers" call that automatically does smart
	; paging will be a benefit for things like triangle rasterisation in the future.


	; Dynamically reprogram to preserve colour, put start y in IXl.
	ld (@+load_colour + 1), a
	ld ixl, e

	; Store height into IYh.
	ld a, e
	sub d
	ld iyh, a

	; Scan edges.
	ld iyl, a
	ld de, edge_list_left
	call @+output_edge

	ld iyl, iyh
	exx
	ld de, edge_list_right
	call @+output_edge

	; Walk edges, overprinting where width is non-zero.
	ld hl, edge_list_left
	ld de, edge_list_right

	; Shuffle IXl into IYl. TODO: could I avoid this through avoiding use of IYl elsewhere?
	ld a, ixl
	ld iyl, a

@overprint_line:
	ld a, (de)
	inc de
	ld b, (hl)
	inc hl
	cp b
	jr z, @+no_line

	ld c, a					; B = left, C = right.
	ld a, iyl				; A = screen y.

	; TODO: it's very dumb to call spans.getaddress every line.
	; But to avoid that I'd need to be a lot more careful about dealing with alignment.

	push de
	push hl

	call spans.getaddress	; HL = pointer to start of spans.
@load_colour:
	ld d, 0					; D = colour.
	call spans.overprint

	pop hl
	pop de

@no_line:
	dec iyl
	dec iyh
	jr nz, @-overprint_line

	ret

;
; 
;
@output_edge:
	; Set BC:IXh = delta.
	ld ixh, c
	ld c, b

	ld a, b
	rla				; carry = sign bit
	sbc a, a		; a = a - a (- another bit, if sign was set)
	ld b, a

	; Set HL:A = left position.
	xor a

@output_line:
	; Clamp and write HL to (DE), incrementing the pointer.
	push af
	ex de, hl
	ld a, d
	or a
	jr z, @+write_literal
	jp p, @+write_255

	ld (hl), 0x00
	inc hl
	jr @+increment

@write_255:
	ld (hl), 0xff
	inc hl
	jr @+increment

@write_literal:
	ld (hl), e
	inc hl

@increment:
	ex de, hl

	; HL:A += BC:IXh.
	pop af
	add a, ixh
	adc hl, bc

	; Test for end of loop.
	dec iyl
	jr nz, @-output_line

	ret
