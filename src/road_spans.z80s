
; Adds the 8-bit unsigned value in the register in the operand to DE. Clobbers A.
addde: MACRO
	ld a, e
	add \0
	ld e, a

	adc d
	sub e
	ld d, a
	ENDM

; Subtracts the 8-bit unsigned value in the register in the operand from DE. Clobbers A.
subde: MACRO
	ld a, e
	sub \0
	ld e, a

	ld a, d
	sbc 0
	ld d, a
	ENDM

fill_to: MACRO
	ld (hl), \0
	inc h
	ld (hl), \1
	dec h
	ld l, \0
	ENDM

;
; road.span2d
;
;	Input:
;		HL = pointer to span buffer.
;		DE = centre of road.
;		B = half road width.
;		C = half line width.
;		A = y offset.
;
;	Output:
;		H = pointer within colour portion of span buffer.
;
;	Clobbers:
;		A, DE, L, IXl.
;
road.span:
	; Get a grass colour into IXl.
	rla
	ld ixl, grass_colour1
	jr nc, @+keep_grass_colour1
	ld ixl, grass_colour2
	@keep_grass_colour1:

	; Consider whether to draw a centre line.
	rla
	jp nc, @+draw_without_line		; No line; this is a gap.

	ld a, c
	or a
	jp z, @+draw_without_line		; No line; it is too small to register.

@draw_with_line:
	; Test whether left-edge of road is in 8-bit range. If so can proceed with a pure 8-bit draw.
	subde b
	jp m, @+road_starts_off_left
	jr nz, @+complete_with_grass	; If the left edge is off screen to the right, all is grass.

	ld a, ixl		; grass colour
	fill_to e, a

	ld a, b
	sub c
	ld d, a			; D = road width - line width.

	ld a, e
	add d
	jr c, @+complete_with_road

@from_road_8bit:
	fill_to a, road_colour

	add c
	jr c, @+complete_with_line
	add c
	jr c, @+complete_with_line
	fill_to a, line_colour

	add d
	jr c, @+complete_with_road
	fill_to a, road_colour
	jr @+complete_with_grass

@road_starts_off_left:
	; Road started off left of display; test position of start of line.
	addde b
	subde c
	jp m, @+line_starts_off_left
	jr nz, @+complete_with_road	; Road was off-screen to the left, line was off-screen to the right. So all road.

	; Left edge of line was on-screen so fill road to it and proceed in 8-bit from there.
	ld a, b
	sub c
	ld d, a			; D = road width - line width.

	ld a, e
	jr @-from_road_8bit

@right_starts_off_left:
	; Test right-edge of road.
	subde c
	addde b

	jp m, @+complete_with_grass
	jr nz, @+complete_with_road

	fill_to e, road_colour
	jr @+complete_with_grass

;
; 'Complete'rs; draw a solid colour to the end of the display and stop.
;

@complete_with_grass:
	ld (hl), 0xff
	inc h
	ld a, ixl
	ld (hl), a
	ret

@complete_with_line:
	ld (hl), 0xff
	inc h
	ld (hl), line_colour
	ret

@complete_with_road:
	ld (hl), 0xff
	inc h
	ld (hl), road_colour
	ret

@line_starts_off_left:
	; Test right-edge of line.
	addde c
	addde c
	jp m, @-right_starts_off_left
	jr nz, @-complete_with_line

	; Right edge of line ends within display. Go 8-bit from there.
	ld a, b
	sub c
	ld c, a

	ld a, e
	fill_to a, line_colour
	add c
	jr c, @-complete_with_road
	fill_to a, road_colour
	jr @-complete_with_grass

@draw_without_line:
	; Test whether left-edge of road is in 8-bit range. If so can proceed with a pure 8-bit draw.
	subde b
	jp m, @+starts_off_left
	jr nz, @-complete_with_grass	; If the left edge is off screen to the right, all is grass.

	ld a, ixl			; grass colour
	fill_to e, a

	; Add twice road width to get to the other side.
	ld a, e
	add b
	jr c, @-complete_with_road
	add b
	jr c, @-complete_with_road

	fill_to a, road_colour
	jr @-complete_with_grass

@starts_off_left:
	; Find right edge of road.
	addde b
	addde b
	jp m, @-complete_with_grass
	jr nz, @-complete_with_road

	fill_to e, road_colour
	jr @-complete_with_grass
