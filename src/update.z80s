;
; Called once per frame by by span_buffers/game_loop.z80s.
;
; BC = the number of 50Hz ticks that have occurred since update was last called.
; It is guaranteed to be a non-zero number.
;
update:
	push bc
	call @+update
	pop bc
	djnz update

@update:
	; Read joystick/67890.
	ld bc, 0xeffe
	in a, (c)
	rra
	rra
	jr c, @+no_up

	ld hl, (player.yvelocity)
	ld de, 8
	add hl, de
	ld (player.yvelocity), hl

	@no_up:
	rra
	jr c, @+no_down

	ld hl, (player.yvelocity)
	ld de, -8
	add hl, de
	ld (player.yvelocity), hl

	@no_down:
	rra 
	jr c, @+no_right

	ld bc, -256
	ld (player.xvelocity), bc

	@no_right:
	rra
	jr c, @+no_left

	ld bc, 256
	ld (player.xvelocity), bc

	@no_left:

	; Read QW.
	ld bc, 0xfbfe
	in a, (c)
	rra
	jr c, @+no_q

	call road.curve_left

	ld hl, (curvature)
	ld bc, -7
	add hl, bc
	ld (curvature), hl

	jr @+no_w

	@no_q:
	rra
	jr c, @+no_w
	call road.curve_right

	ld hl, (curvature)
	ld bc, 7
	add hl, bc
	ld (curvature), hl

	@no_w:

	;
	; Y velocity.
	;

		; Apply.
		ld a, (player.y + 2)
		ld d, a
		ld hl, (player.y)					; D:HL = player,y

		ld a, (player.yvelocity + 1)
		rla
		sbc a
		ld bc, (player.yvelocity)			; A:BC = velocity, sign extended.

		add hl, bc
		adc d

		ld (player.y), hl
		ld (player.y + 2), a

		ld a, (player.yvelocity + 1)
		sra a

		; Dampen a little.
		ld b, 0x00
		ld c, a
		or a
		jp p, @+positive
		ld b, 0xff
		@positive:

		ld c, a
		ld hl, (player.yvelocity)
		or a
		sbc hl, bc
		ld (player.yvelocity), hl

	;
	; X velocity.
	;
		; Apply. With 8-bit arithmetic in order to catch overflow.
		ld bc, (player.xvelocity)
		ld hl, (player.x)
		ld a, c
		add l
		ld l, a
		ld a, b
		adc h
		ld h, a
		jp po, @+no_overflow

		or a
		sbc hl, bc

	@no_overflow:
		ld (player.x), hl

		; Dampen harshly.
		ld hl, (player.xvelocity)
		sra b
		rr c
		sra b
		rr c
		or a
		sbc hl, bc
		ld (player.xvelocity), hl

	ret
