;
; Called once per frame by by span_buffers/game_loop.z80s.
;
; B = the number of 50Hz ticks that have occurred since update was last called.
; It is guaranteed to be a non-zero number.
;
@accelerate: db 0
@brake: db 0
@left: db 0
@right: db 0

update:
	;
	; Read input only once. It won't change significantly in the available time.
	;

	push bc

		; Seed D, E, H, L to 0xff. Bits from other locations will be shifted into them.
		; If any is not 0xff at the end then that indicates:
		;
		;	D != 0xff => accelerate.
		;	E != 0xff => brake.
		;	H != 0xff >= left.
		;	L != 0xff >= right.
		ld d, 0xff
		ld e, d
		ld h, d
		ld l, d

		;
		; Read joystick input via port $EFFE.
		;
		;	b0 = accelerate [0],
		;	b2 = brake [8],
		;	b3 = right [7],
		;	b3 = left [6].
		ld bc, 0xeffe
		in a, (c)
		rra
		rl d
		rra
		rra
		rl e
		rra
		rl l
		rra
		rl h

		;
		; Read cursor keys via port $FFFE.
		;
		;	b1 = accelerate [up],
		;	b2 = brake [down],
		;	b3 = left [left],
		;	b3 = right [right]
		ld b, 0xff
		in a, (c)
		rra
		rra
		rl d
		rra
		rl e
		rra
		rl h
		rra
		rl l

		;
		; Read port $DFFE for O and P.
		;
		;	b0 = right [o],
		;	b1 = left [p]
		ld b, 0xdf
		in a, (c)
		rra
		rl l
		rra
		rl h

		;
		; Read port $FBFE for Q at b0.
		;
		ld b, 0xfb
		in a, (c)
		rra
		rl d

		;
		; Read port $FDFE for A at b0.
		;
		ld b, 0xfd
		in a, (c)
		rra
		rl e

		;
		; Write current inputs, summarising them into b0 of each byte.
		;
	@summarise:
		ld a, d
		cp 0xff
		rla
		ld (@-accelerate), a

		ld a, e
		cp 0xff
		rla
		ld (@-brake), a

		ld a, h
		cp 0xff
		rla
		ld (@-left), a

		ld a, l
		cp 0xff
		rla
		ld (@-right), a

	pop bc

	;
	; Call update routine as many times as requested.
	;
@update_loop:
	push bc

	ld a, (@-accelerate)
	rra
	jr nc, @+no_accelerate

		ld hl, (player.yvelocity)
		ld de, 8
		add hl, de
		ld (player.yvelocity), hl

	@no_accelerate:
	ld a, (@-brake)
	rra
	jr nc, @+no_brake

		ld hl, (player.yvelocity)
		ld de, -8
		add hl, de
		ld (player.yvelocity), hl

	@no_brake:
	ld a, (@-right)
	rra 
	jr nc, @+no_right

		ld bc, -256
		ld (player.xvelocity), bc

	@no_right:
	ld a, (@-left)
	rra
	jr nc, @+no_left

		ld bc, 256
		ld (player.xvelocity), bc

	@no_left:

	;
	; TEMPORARY. Read ZX. Use it to adjust current road curvature.
	;
	ld bc, 0xfefe
	in a, (c)
	rra
	rra
	jr c, @+no_q

		call road.curve_left

		ld hl, (curvature)
		ld bc, -7
		add hl, bc
		ld (curvature), hl
		jr @+no_w

	@no_q:
	rra
	jr c, @+no_w

		call road.curve_right

		ld hl, (curvature)
		ld bc, 7
		add hl, bc
		ld (curvature), hl

	@no_w:

	;
	; Y velocity.
	;

		; Apply.
		ld a, (player.y + 2)
		ld d, a
		ld hl, (player.y)					; D:HL = player,y

		ld a, (player.yvelocity + 1)
		rla
		sbc a
		ld bc, (player.yvelocity)			; A:BC = velocity, sign extended.

		add hl, bc
		adc d

		ld (player.y), hl
		ld (player.y + 2), a

		ld a, (player.yvelocity + 1)
		sra a

		; Dampen a little.
		ld b, 0x00
		ld c, a
		or a
		jp p, @+positive
		ld b, 0xff
		@positive:

		ld c, a
		ld hl, (player.yvelocity)
		or a
		sbc hl, bc
		ld (player.yvelocity), hl

	;
	; X velocity.
	;
		; Apply. With 8-bit arithmetic in order to catch overflow.
		ld bc, (player.xvelocity)
		ld hl, (player.x)
		ld a, c
		add l
		ld l, a
		ld a, b
		adc h
		ld h, a
		jp po, @+no_overflow

		or a
		sbc hl, bc

	@no_overflow:
		ld (player.x), hl

		; Dampen harshly.
		ld hl, (player.xvelocity)
		sra b
		rr c
		sra b
		rr c
		or a
		sbc hl, bc
		ld (player.xvelocity), hl

	pop bc
	dec b
	jp nz, @-update_loop

	ret