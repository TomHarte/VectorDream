;
; Called once per frame by by span_buffers/game_loop.z80s.
;
; B = the number of 50Hz ticks that have occurred since update was last called.
; It is guaranteed to be a non-zero number.
;
@accelerate: db 0
@brake: db 0
@left: db 0
@right: db 0
@curvature_shift: dw 0

@next_curvature_tick: dw 0

update:
	;
	; Read input only once. It won't change significantly in the available time.
	;

	push bc

		include "update/read_input.inc"

	pop bc

	;
	; Call update routines as many times as requested.
	;
@update_loop:
	push bc

		include "update/apply_input.inc"
		include "update/collisions.inc"
		include "update/x_velocity.inc"
		include "update/y_velocity.inc"

		include "update/track.inc"			; Updates the floor, applying corners.

		call objects.update					; Updates visible objects according to their specific logic,
											; and cycles in objects from the static list.

		call traffic.update					; Adds randomised traffic.

		include "update/drag.inc"

	pop bc
	dec b
	jp nz, @-update_loop

		include "update/gauges.inc"

	ret

include "update/objects.z80s"
include "update/traffic.z80s"
include "update/cars.z80s"
