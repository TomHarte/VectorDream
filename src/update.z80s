;
; Called once per frame by by span_buffers/game_loop.z80s.
;
; B = the number of 50Hz ticks that have occurred since update was last called.
; It is guaranteed to be a non-zero number.
;
@accelerate: db 0
@brake: db 0
@left: db 0
@right: db 0
@curvature_shift: dw 0

update:
	;
	; Read input only once. It won't change significantly in the available time.
	;

	push bc

		; Seed D, E, H, L to 0xff. Bits from other locations will be shifted into them.
		; If any is not 0xff at the end then that indicates:
		;
		;	D != 0xff => accelerate.
		;	E != 0xff => brake.
		;	H != 0xff >= left.
		;	L != 0xff >= right.
		ld d, 0xff
		ld e, d
		ld h, d
		ld l, d

		;
		; Read joystick input via port $EFFE.
		;
		;	b0 or b1 = accelerate [0 or 9],
		;	b2 = brake [8],
		;	b3 = right [7],
		;	b3 = left [6].
		ld bc, 0xeffe
		in a, (c)
		rra
		rl d
		rra
		rl d
		rra
		rl e
		rra
		rl l
		rra
		rl h

		;
		; Read cursor keys via port $FFFE.
		;
		;	b1 = accelerate [up],
		;	b2 = brake [down],
		;	b3 = left [left],
		;	b3 = right [right]
		ld b, 0xff
		in a, (c)
		rra
		rra
		rl d
		rra
		rl e
		rra
		rl h
		rra
		rl l

		;
		; Read port $DFFE for O and P.
		;
		;	b0 = right [o],
		;	b1 = left [p]
		ld b, 0xdf
		in a, (c)
		rra
		rl l
		rra
		rl h

		;
		; Read port $FBFE for Q at b0.
		;
		ld b, 0xfb
		in a, (c)
		rra
		rl d

		;
		; Read port $FDFE for A at b0.
		;
		ld b, 0xfd
		in a, (c)
		rra
		rl e

		;
		; Read port $7FFE to accept space at b0 as an alternate accelerate.
		;
		ld b, 0x7f
		in a, (c)
		rra
		rl d

		;
		; Write current inputs, summarising them into b0 of each byte.
		;
	@summarise:
		ld a, d
		cp 0xff
		rla
		ld (@-accelerate), a

		ld a, e
		cp 0xff
		rla
		ld (@-brake), a

		ld a, h
		cp 0xff
		rla
		ld (@-left), a

		ld a, l
		cp 0xff
		rla
		ld (@-right), a

	pop bc

	;
	; Call update routine as many times as requested.
	;
@update_loop:
	push bc

	ld a, (@-accelerate)
	rra
	jr nc, @+no_accelerate

		ld hl, (player.yvelocity)
		ld de, 8
		add hl, de
		ld (player.yvelocity), hl

	@no_accelerate:
	ld a, (@-brake)
	rra
	jr nc, @+no_brake

		ld hl, (player.yvelocity)
		ld a, l
		ld c, h
		ld b, 0

		add a, a
		rl c
		rl b
		add a, a
		rl c
		rl b

		ld a, b
		or c
		jr z, @+zero_velocity
		sbc hl, bc
		jr @+dont_zero

	@zero_velocity:
		ld hl, 00

	@dont_zero:
		ld (player.yvelocity), hl

	@no_brake:
	ld a, (@-right)
	rra 
	jr nc, @+no_right

		ld bc, -256
		ld (player.xvelocity), bc

	@no_right:
	ld a, (@-left)
	rra
	jr nc, @+no_left

		ld bc, 256
		ld (player.xvelocity), bc

	@no_left:

	;
	; TEMPORARY. Read ZX. Use it to adjust current road curvature.
	;
	ld bc, 0xfefe
	in a, (c)
	rra
	rra
	jr c, @+no_curvature_decrement

		ld hl, (curvature)
		dec hl

		; Don't go past 0xff01	(i.e. -255).
		ld a, h
		cp 0xff
		jr nz, @+keep_curvature_decrement

		ld a, l
		cp 0x01
		jr nz, @+keep_curvature_decrement

		jr @+no_curvature_decrement

		@keep_curvature_decrement:
		ld (curvature), hl
		call road.curve_left

		jr @+no_curvature_increment

	@no_curvature_decrement:
	rra
	jr c, @+no_curvature_increment

		ld hl, (curvature)
		inc hl

		; Don't go past 0x00ff (i.e. +255).
		ld a, h
		cp 1
		jr z, @+no_curvature_increment

		ld (curvature), hl
		call road.curve_right

	@no_curvature_increment:

	;
	; Y velocity.
	;

		; Apply.
		ld a, (player.y + 2)
		ld d, a
		ld hl, (player.y)					; D:HL = player.y

		ld a, (player.yvelocity + 1)
		rla
		sbc a
		ld bc, (player.yvelocity)			; A:BC = velocity, sign extended.

		add hl, bc
		adc d

		ld (player.y), hl
		ld (player.y + 2), a

		ld a, (player.yvelocity + 1)
		sra a

		; Dampen a little.
		ld b, 0x00
		ld c, a
		or a
		jp p, @+positive
		ld b, 0xff
		@positive:

		ld c, a
		ld hl, (player.yvelocity)
		or a
		sbc hl, bc
		ld (player.yvelocity), hl

	;
	; X velocity.
	;

	;
	; Push left/right as a function of velocity and curvature.
	;

	ld a, (player.yvelocity + 1)
	ld d, a
	ld hl, (curvature)
	ld a, h
	or a

	jp p, @+positive_curve

		ld a, l
		neg
		ld e, a
		call multiply.u8.u8
		ex de, hl
		ld hl, 0
		or a
		sbc hl, de
		ld (@-curvature_shift), hl

		jr @+curve_done

	@positive_curve:

		ld e, l
		call multiply.u8.u8
		ld (@-curvature_shift), hl

	@curve_done:

	;
	; Sum left/right push of road curvature and current player steering into DE.
	;

		ld de, (@-curvature_shift)
		sra d
		rr e
		sra d
		rr e
		sra d
		rr e

		ld hl, (player.xvelocity)
		add hl, de
		ex de, hl
		; ld de, (player.xvelocity)

	;
	; Add current left/right push to player position.
	; With 8-bit arithmetic in order to catch overflow.
	;
		ld hl, (player.x)
		ld a, e
		add l
		ld l, a
		ld a, d
		adc h
		ld h, a
		jp po, @+no_overflow

		or a
		sbc hl, de

	@no_overflow:
		ld (player.x), hl

	;
	; Dampen effect of steering.
	;
		ld hl, (player.xvelocity)
		ld b, h
		ld c, l
		sra b
		rr c
		sra b
		rr c
		or a
		sbc hl, bc
		ld (player.xvelocity), hl

	pop bc
	dec b
	jp nz, @-update_loop

	ret