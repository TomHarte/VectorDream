@road.centres: ds (192 - top_y) * 2

road.draw:

	;
	; TODO: calculate road centres for real.
	;
	; For now: just write 127 for all centres.
	;
	ld b, 192 - top_y
	ld hl, @-road.centres
@write_centre:
	ld (hl), 127
	inc hl
	ld (hl), 0
	inc hl
	djnz @-write_centre

	;
	; Fill sky above road, a simple solid colour.
	;
	; TODO: maybe throw in some scrolling clouds or a mountain or similar?
	;

	ld d, 0
	ld bc, 0xff00 | sky_colour

@sky.fillpage:
	ld a, d
	call spans.getaddress

@sky.fill:
	ld (hl), b
	inc h
	ld (hl), c

	inc d
	ld a, d
	cp top_y
	jr z, @+sky.stop

	and %11111
	jr z, @-sky.fillpage

	inc h
	jr @-sky.fill

@sky.stop:

	;
	; Draw road, per tables.
	;
	ld iy, @-road.centres
	ld de, 0
	ld a, e
@road.fill:
	add top_y
	and %11111
	jr nz, @+incremental_address

	ld a, e
	add top_y
	call spans.getaddress
	jr @+address_done

	; HL = target span address.
@incremental_address:
	ld l, 0
	inc h

@address_done:
	; Establish B = half road width, C = half line width, A = offset.
	push hl

	ld hl, segments
	add hl, de
	add hl, de
	add hl, de

	ld b, (hl)
	inc hl
	ld c, (hl)
	inc hl
	ld a, (player.y + 1)
	add (hl)

	pop hl

	; Preserve DE for next loop around
	push de

	; Set DE = centre.
	ld e, (iy)
	ld d, (iy + 1)
	inc iy
	inc iy

	; Draw 2d element.
	call road.span2d

	; Increment E and check for having hit line 192.
	pop de
	inc e
	ld a, e
	cp 192 - top_y
	jr nz, @-road.fill

	ret

include "road_spans.z80s"
