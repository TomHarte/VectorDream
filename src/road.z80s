; @road.centres: ds (192 - top_y) * 2

road.draw:

	;
	; Fill sky above road, a simple solid colour.
	;
	; TODO: maybe throw in some scrolling clouds or a mountain or similar?
	;

	ld d, 0
	ld bc, 0xff00 | sky_colour

@sky.fillpage:
	ld a, d
	call spans.getaddress

@sky.fill:
	ld (hl), b
	inc h
	ld (hl), c

	inc d
	ld a, d
	cp top_y
	jr z, @+sky.stop

	and %11111
	jr z, @-sky.fillpage

	inc h
	jr @-sky.fill

@sky.stop:

	;
	; Draw road, per tables.
	;
	ld e, 0
@road.fill:
	ld d, 0

	; B = road width.
	ld hl, road_widths
	add hl, de
	ld b, (hl)

	; C = line width.
	ld hl, line_widths
	add hl, de
	ld c, (hl)

	; A = 1/z, temporarily.
	ld hl, one_over_zs
	add hl, de
	ld a, (hl)

	; H = offset from table.
	ld hl, offsets
	add hl, de
	ld h, (hl)

	; Shuffle A into L.
	ld l, a

	; Add current player position to offset.
	ld a, (player.y+1)
	add h
	ld h, a

	; A = y.
	ld a, e
	add top_y
	call road.span

	; Increment E and check for having hit line 192.
	inc e
	ld a, e
	cp 192 - top_y
	jr nz, @-road.fill

	ret

include "road_spans.z80s"
