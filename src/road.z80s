@road.centres: ds (192 - top_y) * 2

calculate_offset: MACRO
	ld d, \0
	ld e, a
	call multiply.u8.u8

	add hl, hl
	ld l, h
	ld h, 0			; HL >>= 7.
	ENDM

calculate_interpolator: MACRO
	or a
	sbc hl, de				; HL = adder * 128; DE = start.

	xor a
	add hl, hl
	adc 0					; A:HL = adder * 256.

	ex de, hl				; HL = start; A:DE = adder * 256.

	ld ixl, e
	ld c, d
	ld b, a					; BC:IXl = adder.

	xor a					; HL:A = current position.
	ENDM

screen_centre: EQU 127

road.draw:

	;
	; Calculate per-line road skew.
	; TODO: include some curvature.
	;

	ld a, (player.x)	; TODO: + 1
	or a
	jp p, @+player_x_positive

	neg
	calculate_offset one_over_z_0
	push hl					; top of stack = horizontal screen position of line 0.

	ld a, (player.x)
	neg
	calculate_offset one_over_z_127
	pop de					; HL = horizontal screen position at line 128;
							; DE = horizontal screen position at line 0.
							; It's guaranteed that HL >= DE

	calculate_interpolator

	ex de, hl
	ld hl, screen_centre
	or a
	sbc hl, de

	ld de, @-road.centres	; DE = write pointer.
	ld iyl, 192 - top_y		; IYl = loop counter.

@write_centre:
	ex de, hl
	ld (hl), e
	inc hl
	ld (hl), d
	inc hl
	ex de, hl

	sub ixl
	sbc hl, bc

	dec iyl
	jr nz, @-write_centre


	jr @+fill_sky

@player_x_positive:
	calculate_offset one_over_z_0

	push hl					; top of stack = horizontal screen position of line 0.

	ld a, (player.x)
	calculate_offset one_over_z_127

	pop de					; HL = horizontal screen position at line 128;
							; DE = horizontal screen position at line 0.
							; It's guaranteed that HL >= DE


	calculate_interpolator

	ld de, screen_centre
	add hl, de

	ld de, @-road.centres	; DE = write pointer.
	ld iyl, 192 - top_y		; IYl = loop counter.

@write_centre:
	ex de, hl
	ld (hl), e
	inc hl
	ld (hl), d
	inc hl
	ex de, hl

	add a, ixl
	adc hl, bc

	dec iyl
	jr nz, @-write_centre


@fill_sky:
	;
	; Fill sky above road, a simple solid colour.
	;
	; TODO: maybe throw in some scrolling clouds or a mountain or similar?
	;

	ld d, 0
	ld bc, 0xff00 | sky_colour

@sky.fillpage:
	ld a, d
	call spans.getaddress

@sky.fill:
	ld (hl), b
	inc h
	ld (hl), c

	inc d
	ld a, d
	cp top_y
	jr z, @+sky.stop

	and %11111
	jr z, @-sky.fillpage

	inc h
	jr @-sky.fill

@sky.stop:

	;
	; Draw road, per tables.
	;
	ld iy, @-road.centres
	ld de, 0
	ld a, e
@road.fill:
	add top_y
	and %11111
	jr nz, @+incremental_address

	ld a, e
	add top_y
	call spans.getaddress
	jr @+address_done

	; HL = target span address.
@incremental_address:
	ld l, 0
	inc h

@address_done:
	; Establish B = half road width, C = half line width, A = offset.
	push hl

	ld hl, segments
	add hl, de
	add hl, de
	add hl, de

	ld b, (hl)
	inc hl
	ld c, (hl)
	inc hl
	ld a, (player.y + 1)
	add (hl)

	pop hl

	; Preserve DE for next loop around
	push de

	; Set DE = centre.
	ld e, (iy)
	ld d, (iy + 1)
	inc iy
	inc iy

	; Draw 2d element.
	call road.span2d

	; Increment E and check for having hit line 192.
	pop de
	inc e
	ld a, e
	cp 192 - top_y
	jr nz, @-road.fill

	ret

include "road_spans.z80s"
