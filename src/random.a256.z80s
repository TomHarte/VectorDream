ALIGN 256

@random.nibbles:
	db 0x15, 0x41, 0x01, 0x10, 0x44, 0x11, 0x40, 0x04, 0x51, 0x00, 0x45, 0x14, 0x05, 0x55, 0x54, 0x50

;
; random.nibble.spread
;
; Generates a random 'spread' nibble, that is one where bits 0, 2, 4 and 6 are randomised,
; but bits 1, 3, 5 and 7 are guaranteed clear.
;
;	Outputs:
;		A = a random spread nibble as defined above.
;
;	Clobbers:
;		B.
;
random.nibble.spread:
	; Dumbest RNG ever:
	;
	;	*	keep an index into an array of randomly-sorted nibbles;
	;	*	at each call, increment the pointer and exclusive-OR it with R;
	;	*	return whatever is at that position in the table.
	;
	ld a, (@load_result + 1)
	ld b, a
	inc b
	ld a, r
	rra
	rra
	rra
	xor b
	and 15
	ld (@load_result + 1), a		; Use dynamic reprogramming for two reasons:
									;
									;	(1)	because this value is going to be stored in memory somewhere anyway, so it might as well
									;		be in the instruction stream; and
									;	(2)	to limit the number of registers clobbered.

@load_result:
	ld a, (@random.nibbles)
	ret

;
; random.nibble
;
; Generates a random byte.
;
;	Outputs:
;		A = a random byte.
;
;	Clobbers:
;		BC.
;
random.byte:
	call random.nibble.spread
	add a, a
	ld c, a					; C = a random nibble in the top 4 bits.
	call random.nibble.spread
	or c
	ret
