car1:
	db -128					; Current x position.
	db colour.car.blue		; Car colour.
	dw 7					; Forward velocity.

car2:
	db -64
	db colour.car.red
	dw 6

car3:
	db -10
	db colour.car.red
	dw 9

	dw collide_car1
	dw update_car1
draw.car1:
	ld a, (car1+1)
	ld iyl, a
	ld a, (car1)
	jp draw.car

	dw collide_car2
	dw update_car2
draw.car2:
	ld a, (car2+1)
	ld iyl, a
	ld a, (car2)
	jp draw.car

	dw collide_car3
	dw update_car3
draw.car3:
	ld a, (car3+1)
	ld iyl, a
	ld a, (car3)
	jp draw.car
