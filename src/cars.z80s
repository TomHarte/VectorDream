@cars: EQU FOR NUM_CARS
car{@cars}:
@cardef:
	db 0					; X position.
	db colour.car.blue		; Car colour.
	dw 5					; Forward velocity.

	jp car{@cars}.collide
	jp car{@cars}.update
car{@cars}.draw:
	ld a, (@-cardef + offsetof.car.colour)
	ld iyl, a
	ld a, (@-cardef + offsetof.car.x)
	jp draw.car
NEXT @cars

offsetof.car.x:			EQU 0
offsetof.car.colour:	EQU 1
offsetof.car.velocity:	EQU 2
sizeof.car:				EQU 4
