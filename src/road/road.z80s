;
; Draws a classic-style 2.5d road into a span buffer.
;
; Exported symbols:
;
;	* `road.draw` which draws the road.
;

calculate_offset: MACRO
	ld d, \0
	ld e, a
	call multiply.u8.u8

	add hl, hl
	ld l, h
	ld h, 0			; HL >>= 7.
	ENDM

calculate_interpolator: MACRO
	or a
	sbc hl, de				; HL = adder * 64; DE = start.

	xor a
	add hl, hl
	add hl, hl
	add hl, hl
	adc 0					; A:HL = adder * 256.

	ex de, hl				; HL = start; A:DE = adder * 256.

	ld ixl, e
	ld c, d
	ld b, a					; BC:IXl = adder.

	xor a					; HL:A = current position.
	ENDM

screen_centre: EQU 127

;
; road.draw
;
; Draws the current road based on its level of curvature and upon the global variables player.[x/y].
;
;	Input:
;		global variables player.x, player.y and the current curvature state.
;
;	Output:
;		none directly; populates the span buffer.
;
;	Clobbers:
;		A, BC, DE, HL, IY, IX.
;
road.draw:

	;
	; Calculate per-line road skew.
	; TODO: include some curvature.
	;

	ld a, (player.x + 1)
	or a
	jp p, @+player_x_positive

	neg
	calculate_offset one_over_z_0
	push hl					; top of stack = horizontal screen position of line 0.

	ld a, (player.x + 1)
	neg
	calculate_offset one_over_z_64
	pop de					; HL = horizontal screen position at line 128;
							; DE = horizontal screen position at line 0.
							; It's guaranteed that HL >= DE

	calculate_interpolator

	ex de, hl
	ld hl, screen_centre
	or a
	sbc hl, de

	; HL:A = starting span coordinate in 16:8 form.
	; BC:IXl = per-line delta.
	ld de, road.centres				; DE = write pointer.
	ld ixh, bottom_y - top_y		; IYl = loop counter.

@write_centre:
	ex de, hl
	ld (hl), e
	inc l
	ld (hl), d
	inc hl
	ex de, hl

	sub ixl
	sbc hl, bc

	dec ixh
	jr nz, @-write_centre


	jr @+apply_curvature

@player_x_positive:
	calculate_offset one_over_z_0

	push hl					; top of stack = horizontal screen position of line 0.

	ld a, (player.x + 1)
	calculate_offset one_over_z_64

	pop de					; HL = horizontal screen position at line 128;
							; DE = horizontal screen position at line 0.
							; It's guaranteed that HL >= DE


	calculate_interpolator

	ld de, screen_centre
	add hl, de

	; HL:A = starting span coordinate in 16:8 form.
	; BC:IXl = per-line delta.
	ld de, road.centres				; DE = write pointer.
	ld ixh, bottom_y - top_y		; IYl = loop counter.

@write_centre:
	ex de, hl
	ld (hl), e
	inc l
	ld (hl), d
	inc hl
	ex de, hl

	add a, ixl
	adc hl, bc

	dec ixh
	jr nz, @-write_centre


@apply_curvature:
	ld hl, road.centres
	ld de, road.curvature
	ld b, bottom_y - top_y

@apply:

	; Load only high byte of accumulated curvature, test sign.
	inc e
	ld a, (de)
	or a
	jp p, @+positive

	; Add to low byte
	add (hl)
	ld (hl), a
	inc l

	jr c, @+advance

	ld a, 0xff
	add (hl)
	ld (hl), a
	jr @+advance

@positive:
	; Add to low byte of road centre and propagate carry.
	add (hl)
	ld (hl), a
	inc l

	jr nc, @+no_carry
	inc (hl)

@no_carry:
@advance:
	; Advance.
	inc de
	inc hl

	; Repeat.
	djnz @-apply


	;
	; Fill sky above road, a simple solid colour.
	;
	; TODO: maybe throw in some scrolling clouds or a mountain or similar?
	;
	xor a
	ld d, a
	ld bc, 0xff00 | sky_colour
	ld l, a
	ld a, (current_spans)
	ld e, a

@fill_sky: EQU FOR top_y
	IF @fill_sky & %11111 == 0
		ld a, PAGE.FIRSTSPAN + ((@fill_sky / 32) * 2)
		out (HMPR), a
		ld h, e
	ENDIF

	ld (hl), b
	inc h
	ld (hl), c
	inc h
NEXT @fill_sky


	;
	; Draw road, per tables.
	;
@road.fill: EQU for bottom_y - top_y
@screen_y: EQU @road.fill + top_y
	IF @screen_y & %11111 == 0
		ld a, PAGE.FIRSTSPAN + (@screen_y / 32) * 2
		out (HMPR), a
		ld a, (current_spans)
		ld h, a
	ENDIF

	; Establish B = half road width, C = half line width, A = offset.
@segment: EQU segments + @road.fill * 4
	ld bc, (@segment)

	ld a, (player.y + 1)
	ld d, a
	ld a, (@segment + 2)
	add d

	; Set DE = centre.
	ld de, (road.centres + @road.fill * 2)

	; Draw 2d element.
	call road.span

	IF @road.fill != bottom_y - top_y - 1
		inc h
		ld l, 0
	ENDIF
NEXT @road.fill

	ret

include "spans.z80s"

road.setup:
	;
	; Zero out the curvature table.
	;
	ld hl, road.curvature
	ld (hl), 0
	ld de, road.curvature + 1
	ld bc, (bottom_y - top_y - 1) * 2		; - 1 as the first entry was written just above.
	ldir

	ret

;
; Adjusts current road curvature by one notch rightward.
;
road.curve_right:
	ld ix, curve_offsets
	ld hl, road.curvature
	ld a, bottom_y - top_y
	ld b, 0

@apply:
	; BC = curvature delta.
	ld c, (ix)

	; DE = current curvature.
	ld e, (hl)
	inc l
	ld d, (hl)

	; Add BC to DE.
	ex de, hl
	add hl, bc
	ex de, hl

	; Write out current curvature.
	ld (hl), d
	dec l
	ld (hl), e

	; Advance pointers.
	inc l
	inc hl
	inc ix

	; Repeat if necessary.
	dec a
	jr nz, @-apply

	ret

;
; Adjusts current road curvature by one notch leftward.
;
road.curve_left:
	ld ix, curve_offsets
	ld hl, road.curvature
	ld a, bottom_y - top_y
	ld b, 0

@apply:
	; BC = curvature delta.
	ld c, (ix)

	; DE = current curvature.
	ld e, (hl)
	inc l
	ld d, (hl)

	; Subtract BC from DE.
	ex de, hl
	or a
	sbc hl, bc
	ex de, hl

	; Write out current curvature.
	ld (hl), d
	dec l
	ld (hl), e

	; Advance pointers.
	inc l
	inc hl
	inc ix

	; Repeat if necessary.
	dec a
	jr nz, @-apply

	ret
