;
; Draws a classic-style 2.5d road into a span buffer.
;
; Exported symbols:
;
;	* `road.draw` which draws the road.
;

calculate_offset: MACRO
	ld d, \0
	ld e, a
	call multiply.u8.u8

	add hl, hl
	ld l, h
	ld h, 0			; HL >>= 7.
	ENDM

calculate_interpolator: MACRO
	or a
	sbc hl, de				; HL = adder * 128; DE = start.

	xor a
	add hl, hl
	adc 0					; A:HL = adder * 256.

	ex de, hl				; HL = start; A:DE = adder * 256.

	ld ixl, e
	ld c, d
	ld b, a					; BC:IXl = adder.

	xor a					; HL:A = current position.
	ENDM

screen_centre: EQU 127
final_line: EQU 192

;
; road.draw
;
; Draws the current road based on its level of curvature and upon the global variables player.[x/y].
;
;	Input:
;		global variables player.x, player.y and the current curvature state.
;
;	Output:
;		none directly; populates the span buffer.
;
;	Clobbers:
;		A, BC, DE, HL, IY, IX.
;
road.draw:

	;
	; Calculate per-line road skew.
	; TODO: include some curvature.
	;

	ld a, (player.x + 1)
	or a
	jp p, @+player_x_positive

	neg
	calculate_offset one_over_z_0
	push hl					; top of stack = horizontal screen position of line 0.

	ld a, (player.x + 1)
	neg
	calculate_offset one_over_z_127
	pop de					; HL = horizontal screen position at line 128;
							; DE = horizontal screen position at line 0.
							; It's guaranteed that HL >= DE

	calculate_interpolator

	ex de, hl
	ld hl, screen_centre
	or a
	sbc hl, de

	; HL:A = starting span coordinate in 16:8 form.
	; BC:IXl = per-line delta.
	ld de, road.centres				; DE = write pointer.
	ld ixh, final_line - top_y		; IYl = loop counter.

@write_centre:
	ex de, hl
	ld (hl), e
	inc hl
	ld (hl), d
	inc hl
	ex de, hl

	sub ixl
	sbc hl, bc

	dec ixh
	jr nz, @-write_centre


	jr @+apply_curvature

@player_x_positive:
	calculate_offset one_over_z_0

	push hl					; top of stack = horizontal screen position of line 0.

	ld a, (player.x + 1)
	calculate_offset one_over_z_127

	pop de					; HL = horizontal screen position at line 128;
							; DE = horizontal screen position at line 0.
							; It's guaranteed that HL >= DE


	calculate_interpolator

	ld de, screen_centre
	add hl, de

	; HL:A = starting span coordinate in 16:8 form.
	; BC:IXl = per-line delta.
	ld de, road.centres				; DE = write pointer.
	ld ixh, final_line - top_y		; IYl = loop counter.

@write_centre:
	ex de, hl
	ld (hl), e
	inc hl
	ld (hl), d
	inc hl
	ex de, hl

	add a, ixl
	adc hl, bc

	dec ixh
	jr nz, @-write_centre


@apply_curvature:
	ld hl, road.centres
	ld de, road.curvature
	ld b, final_line - top_y

	; Below currently assumes all curvature is positive.

@apply:

	; Load only high byte of accumulated curvature, test sign.
	inc de
	ld a, (de)
	or a
	jp p, @+positive

	; Add to low byte
	add (hl)
	ld (hl), a
	inc hl

	jr c, @+advance

	ld a, 0xff
	add (hl)
	ld (hl), a
	jr @+advance

@positive:
	; Add to low byte of road centre and propagate carry.
	add (hl)
	ld (hl), a
	inc hl

	jr nc, @+no_carry
	inc (hl)

@no_carry:
@advance:
	; Advance.
	inc de
	inc hl

	; Repeat.
	dec b
	jr nz, @-apply


@fill_sky:
	;
	; Fill sky above road, a simple solid colour.
	;
	; TODO: maybe throw in some scrolling clouds or a mountain or similar?
	;

	ld d, 0
	ld bc, 0xff00 | sky_colour

@sky.fillpage:
	ld a, d
	call spans.getaddress

@sky.fill:
	ld (hl), b
	inc h
	ld (hl), c

	inc d
	ld a, d
	cp top_y
	jr z, @+sky.stop

	and %11111
	jr z, @-sky.fillpage

	inc h
	jr @-sky.fill

@sky.stop:

	;
	; Draw road, per tables.
	;
	ld iy, road.centres
	ld de, 0
	ld a, e
@road.fill:
	add top_y
	and %11111
	jr nz, @+incremental_address

	ld a, e
	add top_y
	call spans.getaddress
	jr @+address_done

	; HL = target span address.
@incremental_address:
	ld l, 0
	inc h

@address_done:
	; Establish B = half road width, C = half line width, A = offset.
	push hl

	ld hl, segments
	add hl, de
	add hl, de
	add hl, de

	ld b, (hl)
	inc hl
	ld c, (hl)
	inc hl
	ld a, (player.y + 1)
	add (hl)

	pop hl

	; Preserve DE for next loop around
	push de

	; Set DE = centre.
	ld e, (iy)
	ld d, (iy + 1)
	inc iy
	inc iy

	; Draw 2d element.
	call road.span

	; Increment E and check for having hit the final line.
	pop de
	inc e
	ld a, e
	cp final_line - top_y
	jr nz, @-road.fill

	ret

include "spans.z80s"

road.setup:
	;
	; Zero out the curvature table.
	;
	ld hl, road.curvature
	ld (hl), 0
	ld de, road.curvature + 1
	ld bc, (final_line - top_y) * 2
	ldir

	ret

;
; Adjusts current road curvature by one notch rightward.
;
road.curve_right:
	ld ix, curve_offsets
	ld hl, road.curvature
	ld a, final_line - top_y
	ld b, 0

@apply:
	; BC = curvature delta.
	ld c, (ix)

	; DE = current curvature.
	ld e, (hl)
	inc hl
	ld d, (hl)

	; Add BC to DE.
	ex de, hl
	add hl, bc
	ex de, hl

	; Write out current curvature.
	ld (hl), d
	dec hl
	ld (hl), e

	; Advance pointers.
	inc hl
	inc hl
	inc ix

	; Repeat if necessary.
	dec a
	jr nz, @-apply

	ret

;
; Adjusts current road curvature by one notch leftward.
;
road.curve_left:
	ld ix, curve_offsets
	ld hl, road.curvature
	ld a, final_line - top_y
	ld b, 0

@apply:
	; BC = curvature delta.
	ld c, (ix)

	; DE = current curvature.
	ld e, (hl)
	inc hl
	ld d, (hl)

	; Subtract BC from DE.
	ex de, hl
	or a
	sbc hl, bc
	ex de, hl

	; Write out current curvature.
	ld (hl), d
	dec hl
	ld (hl), e

	; Advance pointers.
	inc hl
	inc hl
	inc ix

	; Repeat if necessary.
	dec a
	jr nz, @-apply

	ret
