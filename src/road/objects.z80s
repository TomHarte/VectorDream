;
; Object fields (EQUd to their offsets):
;

object.depth: EQU 0			; Planar depth, i.e. along the ground, of this object.

object.draw: EQU 2			; Draw block for object. When called:
							;
							;	HL = centre of the road in 2d at the depth of the object;
							;	(@object_width) = width of a piece of road at the object's depth;
							;	(@base_line) = line on screen where the bottom of the object should appear.

;
; Hence, total size is:
;
object.sizeof: EQU 4


;
; A draw block is primarily the code necessary to draw the object; it also has indirections
; towards the code necessary to update and to test collisions with an object.
;
; Although drawing will occur **at most** as often as updating and collision testing,
; neither of those is likely to be unique in the general case — e.g. all static objects will
; have the same update function; all static objects of the same size will have the same
; collision function.
;
drawblock.drawcode:		EQU 0	; Code for drawing is the thing pointed to by a draw block.
drawblock.update_jp:	EQU -3	; Three bytes before the drawing code is a JP to the update code.
drawblock.collide_jp:	EQU -6	; Six bytes before that is a JP to the update code.

;
; A list of active objects. Each is merely a two-byte distance from the viewer, and
; a routine to draw the thing.
;

@active_dummy:
	; A dummy object immediately before the list; this means that a backwards search
	; when sorting wlll always stop at the start of the list.
	dw 0xffff
	dw 0


active_objects.count: EQU 8

active_objects:
@object: EQU FOR active_objects.count
	dw 0xffff			; Distance from player = -1 => list terminated.
						; (though only the high byte is tested)
	dw 0
NEXT @object

@end_of_objects:
	; A dummy object straight after the list; if this address is found when searching
	; for an empty slot, none are available.
	dw 0xffff
	dw 0

ASSERT (@end_of_objects >> 8) == (@active_dummy >> 8)

;
; active_objects.erase
;
; Removes the object at (DE) from the list.
;
; 	Input:
;		DE = pointer to object to remove from the list.
;
; 	Output:
;		None; the object will have been removed from the list.
;
;	Clobbers:
;		A, BC, DE, HL.
;
active_objects.erase:
	ld h, d
	ld l, e

	ASSERT object.sizeof == 4
	inc l
	inc l
	inc l
	inc l

@move_entry:
	; Copy distance from camera.
	ldi
	ld a, (hl)		; Grab a copy of the high byte of distance of the incoming object as it passes by.
	ldi

	; Exit if the terminator has just been copied down.
	inc a
	ret z

	; Copy update function and repeat.
	ldi
	ldi
	jr @-move_entry


;
; active_objects.back_reserve
;
; Reserves an object slot at the back of the list, i.e. **closest** to the viewer,
; if one is available.
;
; 	Input:
;		None.
;
; 	Output:
;		HL = address of reserved slot, if one was found;
;		carry = clear if a slot was found, set otherwise.
;
;	Clobbers:
;		A.
;
active_objects.back_reserve:
	; Check whether the slot at end_of_objects - 4 is empty.
	; If not then the list is full.
	ld a, (@end_of_objects - 3)
	inc a
	jr z, @+do_insert

	; List is full. Sorry!
	scf
	ret

@do_insert:
	; Find the first available slot.

	ld hl, active_objects + 1
@test_slot:
	ld a, (hl)
	inc a
	jr z, @+found_slot

	inc l
	inc l
	inc l
	inc l
	jr @-test_slot

@found_slot:
	dec l
	or a
	ret


;
; active_objects.front_reserve
;
; Reserves an object slot at the front of the list, i.e. **furthest** to the viewer,
; if one is available.
;
; 	Input:
;		None.
;
; 	Output:
;		HL = address of reserved slot, if one was found;
;		carry = clear if a slot was found, set otherwise.
;
;	Clobbers:
;		A, BC, DE.
;
active_objects.front_reserve:
	; Check whether the slot at end_of_objects - 4 is empty.
	; If not then the list is full.
	ld a, (@end_of_objects - 3)
	inc a
	jr z, @+do_insert

	; List is full. Sorry!
	scf
	ret

@do_insert:
	; Open up the front slot with a lazy LDDR.
	; TODO: can improve.
	ld de, @end_of_objects - 1
	ld hl, @end_of_objects - 1 - object.sizeof
	ld bc, @end_of_objects - active_objects - object.sizeof
	lddr

	; Return front slot.
	ld hl, active_objects
	or a
	ret

;
; active_objects.sort
;
; Sorts the current active_objects list so that the furthest comes first.
;
; Warning: this is not a stable sort. Objects at the same depth may change positions.
;
; 	Input:
;		None.
;
; 	Output:
;		None; as a side effect the active_objects list will now be sorted.
;
;	Clobbers:
;		A, IY, BC, DE.
;
active_objects.sort:
	;
	; This is a game where the object list is probably either already sorted, or is close to being properly sorted.
	; So insertion sort is appropriate.
	;

	ld iy, active_objects

	;
	; Exit immediately if list is empty.
	;
	ld a, (iy + object.depth + 1)
	inc a
	ret z

@test_object:
	;
	; Test for end of list.
	;
	ld a, (iy + object.sizeof + object.depth + 1)
	ld b, a		; Keep high byte of depth of next object to avoid a double fetch.
	inc a
	ret z

	;
	; Compare depth of object one ahead of this one and this one.
	;
	compare: MACRO
		ld a, (iy + object.sizeof + object.depth + 0)
		sub (iy + object.depth + 0)
		ld a, \0
		sbc (iy + object.depth + 1)
	ENDM
	compare b

	; Ordering incorrect: search backwards to find out where the next object should be,
	; and move list data appropriately.
	jr nc, @+adjust_order

	; Ordering correct: just advance.
@advance:
	ld bc, object.sizeof
	add iy, bc
	jr @-test_object

@adjust_order:
	push iy

	ld bc, -4
@test_next:
	; Swap object and one before it, then recede and compare again.
	swap: MACRO
		ld e, (iy + \0)
		ld d, (iy + object.sizeof + \0)
		ld (iy + \0), d
		ld (iy + object.sizeof + \0), e
	ENDM

	swap (object.depth + 0)
	swap (object.depth + 1)
	swap (object.draw + 0)
	swap (object.draw + 1)

	add iy, bc

	compare (iy + object.sizeof + object.depth + 1)
	jr nc, @-test_next

	pop iy
	jr @-advance


;
; Transient storage used by objects.draw.
;
@ratio:
	db 0	; Throwaway byte to allow 16-bit stores.
	db 0	; Actual ratio.
object_pointer:
	dw 0

;
; Per-object transient storage shared with the draw routines.
;
object_width: db 0
@base_line: 
	db 0	; Actual value.
	db 0	; "Top byte" of value. Always 0. But allows 16-bit loads.
screen_line:
	db 0

;
; objects.draw
;
; Walks the active object list, drawing each thing in it.
;
; Requires that the list currently be sorted.
;
;	Clobbers:
;		A, BC, DE, HL, IX, IY.
;
objects.draw:

	;
	; This walks the per-line segments list, as I wanted to fit it into the
	; span-drawing loop when that list is being walked linearly anyway. Though
	; it contains early-exit logic.
	;
	; But if I'm doing this separately, a binary search or an initial broad-table
	; lookup would be worth investigating.
	;

	ld hl, active_objects

	; Loads HL with the player-relative depth of the object pointed to by HL.
	; Sets the zero flag if the list has ended.
get_player_relative_depth: MACRO
	; Get player-relative depth of current object into DE.
	ld e, (hl)
	inc l
	ld d, (hl)
	inc l
	ld a, d
	inc a
	ld (object_pointer), hl
	ex de, hl
	ENDM

	get_player_relative_depth
	ret z

@test_line: EQU FOR bottom_y - top_y - 1
@test:
	; HL = depth of object; compare with depth of line.
	ld a, l
	sub depth_{@test_line + 1} \ 256
	ld a, h
	sbc depth_{@test_line + 1} / 256
	jr c, @+object_not_found		; (depth of line) <= (depth of object), so object is here.

	;
	; Precept: objects are 'rare'. So using index registers here isn't a bottleneck.
	; Additionally, this loop is unrolled so direct table loads would cast a large footprint.
	;
	ld a, @test_line + 1
	call @+object_found
	jr @-test						; Repeat test on this line; multiple objects may be here.

@object_not_found:
NEXT @test_line
	ret



@object_found:
	;
	; At entry:
	;
	;	A = base line.
	;	HL = depth of object.
	;

	ld (@-base_line), a

	dec a
	ld c, a
	ld b, 0
	ld ix, segments
	add ix, bc
	add ix, bc
	add ix, bc
	add ix, bc						; IX = pointer to previous line.

	ld c, (ix + 6)
	ld b, (ix + 7)					; BC = depth of current line.
	or a
	sbc hl, bc						; HL = (depth of object) - (depth of current line).

	ld e, (ix + 2)
	ld d, (ix + 3)
	ex de, hl						; HL = depth of previous line.
	or a
	sbc hl, bc

		; HL = difference in depths between line object is on and line before.
		; DE = difference in depths between line object is on and object.

	call getratio.uf16.uf16	; B = DE / HL, required ratio, in 0:8 fixed point.

	;
	; Up to here:
	;
	;	@base_line is populated.
	;	L = ratio (in 0:8 fixed point) of (object depth - closer line depth) / (further line depth - closer line depth).
	;
	; So from here:
	;
	;	Index into road.centres at [a] and [a-1]. Apply ratio to get centre of road at object depth.
	;	Index into segments at [a] and [a-1] to get road widths. Apply ratio to get width of road at object depth.
	;	Draw object with width and x offset that is some multiple of segments-derived calculation, at x = offset + interpolated road centre; bottom y = top_y + A.
	;

	; Possible TODO: special case possible if B = 0.

	; Store ratio (along with redundant write of C).
	ld (@-ratio), bc
	ld e, b

	; Work out interpolated size.
	ld a, (ix + 1)
	ld b, a				; Width at previous line.
	ld a, (ix + 5)		; Width at current line.

	sub b			; Difference in road width.
	ld d, a

	call multiply.u8.u8

	; H = amount to subtract from width at closer value.
	ld a, (ix + 5)
	sub h
	ld (object_width), a		; Establish object width.

	;
	; Grab relevant values from road position table.
	;

	ld hl, road.centres
	ld de, (@-base_line)
	add hl, de
	add hl, de				; HL = pointer into road.centres.

	ld e, (hl)
	inc l
	ld d, (hl)				; DE = centre at previous line.
	inc hl
	ld c, (hl)
	inc l
	ld b, (hl)				; BC = centre at current line.
	push bc

	ex de, hl
	sbc hl, bc		; HL = (centre at line above) - (centre at line)
					; Which is always less than a byte-sized quantity, per corner constraints.
					; Carry is left over from `add hl, de` above so is guaranteed clear.
	jr z, @+no_interpolate
	jp m, @+negative_interpolate

	;
	; Perform BC += (ratio * l).
	;

	ld de, (@-ratio)	; D = ratio.
	ld e, l
	call multiply.u8.u8

	ld c, h
	ld b, 0

	pop hl
	add hl, bc
	jr @+draw_object

@negative_interpolate:
	;
	; Perform BC -= (ratio * -l).
	;

	ld de, (@-ratio)	; D = ratio.
	ld a, l
	neg
	ld e, a				; D = -l

	call multiply.u8.u8

	ld c, h
	ld b, 0

	or a
	pop hl
	sbc hl, bc

@draw_object:
	;
	; HL = centre to use.
	;

	ld a, (@-base_line)
	add top_y
	ld (screen_line), a

	ex de, hl
	ld hl, (object_pointer)
	ld c, (hl)
	inc l
	ld b, (hl)
	inc l
	push hl

	ld (@+call_draw + 1), bc
	ex de, hl
@call_draw:
	call 0

	; Advance `object_pointer` to next object.
	pop hl

	get_player_relative_depth		; Get new depth.
	ret nz							; Exit if list _isn't_ terminated. Otherwise fall through to double_ret.

@double_ret:
	pop bc							; Latest object is behind camera. Force a double-ret.
	ret

@no_interpolate:
	pop af				; Throw away depth stored on the stack.
	ld h, b
	ld l, c
	jr @-draw_object
