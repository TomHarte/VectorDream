;
; Offsets exist within a doubly-linked list.
;
; Fields (EQUd to their offsets):
;

object.depth: EQU 0			; Planar depth, i.e. along the ground, of this object.

object.draw: EQU 2			; Routine to draw an object. When called:
							;
							;	HL = centre of the road in 2d at the depth of the object;
							;	(@object_width) = width of a piece of road at the object's depth;
							;	(@base_line) = line on screen where the bottom of the object should appear.

object.testcollision: EQU 4	; TODO: I haven't quite figured out the semantics here, but likely it'll be
							; that this is called if the object is within the appropriate 'depth' of the
							; player vehicle and it checks the left/right bounds and takes the appropriate
							; collision action if hit.

object.closer: EQU 6		; Pointer to the 'next' object in the list. List is expected to be circular,
							; and longer than a single screen; 

object.further: EQU 8		; Pointer to the 'next' object in the list. List is expected to be circular,
							; and longer than a single screen; 

moveable.x: EQU 10			; Objects that move may also have an x position. At the time of writing this
							; affects vehicles only. It'll probably always affect vehicles only.

car.colour: EQU 11			; Colour; specific to cars.

;
; Hence, total size is:
;
object.sizeof: EQU 10

;
; Object list (hard-coded for now).
;
object1:
	dw 50
	dw draw.car;draw.leftward_arrow
	dw 0
	dw 0			; Nothing is closer.
	dw object2

	db -10
	db racing_red_colour

object2:
	dw 250
	dw draw.car
	dw 0
	dw object1
	dw object3

	db -128
	db racing_blue_colour

object3:
	dw 1000
	dw draw.car
	dw 0
	dw object2
	dw 0			; Nothing is further.

	db 67
	db racing_blue_colour

;
; Pointer to current location within the object list, which
; should be to the furthest object.
;
firstobject:
	dw object1


;
; Transient storage used by objects.draw.
;
@segment_pointer: dw 0
@ratio:
	db 0	; Throwaway byte to allow 16-bit stores.
	db 0	; Actual ratio.
@horizon_depth:
	dw 0

;
; Per-object transient storage shared with the draw routines.
;
object_width: db 0
@base_line: 
	db 0	; Actual value.
	db 0	; "Top byte" of value. Always 0. But allows 16-bit loads.
screen_line:
	db 0

objects.draw:
	; `firstobject` is whichever was first last frame. It might need updating.
	ld iy, (firstobject)

	ld hl, (player.y + 1)
	ld bc, max_object_depth
	add hl, bc
	ld (@-horizon_depth), hl				; Store current location of the horizon, the cutoff point for objects.

	;
	; (1) Follow object.closer for as long as object.depth is greater than maxdepth + player.y and closer objects exist.
	; This will happen very rarely, since the player would need to be moving backwards.
	;

@test_move_closer:
	ld c, (iy + object.depth)
	ld b, (iy + object.depth + 1)
	or a
	ld hl, (@-horizon_depth)
	sbc hl, bc
	jr nc, @+dont_recede			; No carry => object depth was less than maximum depth. So it's in front of the horizon, not behind it.

	ld e, (iy + object.closer)
	ld d, (iy + object.closer + 1)	; DE = pointer to closer object.
	ld a, e
	or d
	ret z							; If this object was beyond the horizon but there's nothing closer then there are no objects to draw.
	ld iyl, e
	ld iyh, d
	jr @-test_move_closer

@dont_recede:

	;
	; (2) Follow object.further for a long as a further object exists for which object.depth is less than or equal to maxdepth + player.y.
	;

@test_move_further:
	ld e, (iy + object.further)
	ld d, (iy + object.further + 1)	; DE = pointer to further object.
	ld a, e
	or d
	jr z, @+dont_advance				; Don't recede if there is no closer object.

	ld ixl, e		; Use IX as a temporary index register.
	ld ixh, d
	ld c, (ix + object.depth)
	ld b, (ix + object.depth + 1)
	or a
	ld hl, (@-horizon_depth)
	sbc hl, bc
	jr c, @+dont_advance			; Carry => object depth was greater than or equal to maximum depth. So it's behind the horizon.

	; Advance then, and keep testing.
	ld iyl, e
	ld iyh, d
	jr @-test_move_further

@dont_advance:

	; (3) Store back to firstobject.
	ld (firstobject), iy

	;
	; From here: IY points to the first object that _might_ be visible.
	; Draw it, if visible, follow the closer link, repeat.
	;

	;
	; As an aside: although this walks the per-line segments list, I wasn't
	; able to fit this into the span-drawing loop at the time of writing,
	; though that's certainly an aspiration.
	;


	ld a, 1					; Don't consider placement on the top line, due to
							; need to have something to interpolate against.
	ld hl, segments + 3		; HL = pointer into depths table (for A = 1).


	;
	; BEGIN: main object loop.
	;
@next_object:
	ex de, hl

	; Get player-relative depth of current object into DE.
	ld l, (iy + object.depth)
	ld h, (iy + object.depth + 1)
	ld bc, (player.y + 1)
	or a
	sbc hl, bc

	; Check whether current visible object is behind camera.
	; If so, drawing is done.
	ret m

	ex de, hl		; DE = object depth; HL = pointer into segments table.

@test_depth:

	inc hl	; Advance to next depth within table.
	inc l
	inc l

	; Let BC = depth of this line.
	ld c, (hl)
	inc l
	ld b, (hl)

	push de			; Save planar depth of object on stack.
	ex de, hl		; Preserve pointer into segments table in DE.

	; Let HL = (depth of object) - (depth of line).
	or a
	sbc hl, bc

	jr nc, @+object_found		; (depth of line) <= (depth of object), so object is here.

	ex de, hl		; Restore pointer into segments table into HL.
	pop de			; Restore planar depth of object.

	inc a
	cp bottom_y - top_y
	jr nz, @-test_depth

	ret
	;
	; END: main object loop.
	;




@object_found:
	; HL = distance from this line to object. Will be positive — it's how far behind the front
	; of this line the object lies.
	;
	; BC still equals depth of this line; recede and get the one before into DE.
	; Then use that to get the difference between the two.

	push hl		; Save distance from line to object — quotient for upcoming ratio calculation.
	ld (@-base_line), a

	ex de, hl	; HL = pointer to depth table.
				; BC = depth of current line.

	dec l
	dec l
	dec l
	dec hl
	ld d, (hl)
	dec l
	ld e, (hl)	; DE = depth of previous line.

	ld (@-segment_pointer), hl

	ex de, hl				; HL = depth of previous line, BC = depth of current line.
	or a
	sbc hl, bc
	ex de, hl				; DE = distance between lines (positive — it was further minus closer).
	pop bc					; BC = distance from line to object.
	call getratio.uf16.uf16	; B = BC / DE, required ratio, in 0:8 fixed point.

	;
	; Up to here:
	;
	;	@base_line and @segment_pointer are populated.
	;	L = ratio (in 0:8 fixed point) of (object depth - closer line depth) / (further line depth - closer line depth).
	;
	; So from here:
	;
	;	Index into road.centres at [a] and [a-1]. Apply ratio to get centre of road at object depth.
	;	Index into segments at [a] and [a-1] to get road widths. Apply ratio to get width of road at object depth.
	;	Draw object with width and x offset that is some multiple of segments-derived calculation, at x = offset + interpolated road centre; bottom y = top_y + A.
	;

	; Possible TODO: special case possible if B = 0.

	; Store ratio (along with redundant write of C).
	ld (@-ratio), bc
	ld e, b

	; Work out interpolated size.
	ld hl, (@-segment_pointer)

	dec l
	ld b, (hl)		; Road width at further line.
	inc l
	inc l
	inc hl
	inc l
	ld a, (hl)		; Road width at closer line.
	push af

	sub b			; Difference in road width.
	ld d, a

	call multiply.u8.u8

	; H = amount to subtract from value that (hl) was pointing to.
	pop af
	sub h
	ld (object_width), a		; Establish object width.

	;
	; Grab relevant values from curvature table.
	;

	ld hl, road.centres - 2
	ld bc, (@-base_line)
	add hl, bc
	add hl, bc


	ld e, (hl)
	inc hl
	ld d, (hl)
	inc hl
	ld c, (hl)
	inc hl
	ld b, (hl)		; DE = centre at line above.
					; BC = centre at line.

	ex de, hl
	or a
	sbc hl, bc		; HL = (centre at line above) - (centre at line)
					; Which is always less than a byte-sized quantity, per corner constraints.
	jr z, @+no_interpolate

	push bc
	jp m, @+negative_interpolate

	;
	; Perform BC += (ratio * l).
	;

	ld de, (@-ratio)	; D = ratio.
	ld e, l
	call multiply.u8.u8

	ld c, h
	ld b, 0
	pop hl
	add hl, bc
	jr @+draw_object

@negative_interpolate:

	;
	; Perform BC -= (ratio * -l).
	;

	ld de, (@-ratio)	; D = ratio.

	ld a, l
	neg
	ld e, a				; D = -l

	call multiply.u8.u8

	ld c, h
	ld b, 0
	pop hl
	or a
	sbc hl, bc

@draw_object:
	;
	; Here: HL = centre to use.
	;

	pop af		; Throw away planar depth of object on stack.

	ld a, (@-base_line)
	add top_y
	ld (screen_line), a

	ld e, (iy + object.draw)
	ld d, (iy + object.draw + 1)
	ld (@+call_draw + 1), de
@call_draw:
	call 0

	;
	; Advance IY to closer object and continue if one exists.
	;
	ld e, (iy + object.closer)
	ld d, (iy + object.closer + 1)
	ld a, e
	or d
	ret z
	ld iyl, e
	ld iyh, d

	ld a, (@-base_line)
	ld hl, (@-segment_pointer)
	inc l
	jp @-next_object

@no_interpolate:
	ld h, b
	ld l, c
	jp @-draw_object



;
; Drawing routines:
;
; HL = centre of object; other parameters are in memory.
; Must preserve IY.
;


add_hl_a: MACRO
	add a, l
	ld l, a
	adc h
	sub l
	ld h, a
	ENDM

sub_hl_a: MACRO
	neg					; Assumed: A is non-zero.
	add l
	ld l, a
	ld a, 0xff
	adc h
	ld h, a
	ENDM

locate_at_right: MACRO
	; Add the 8-bit value (object_width) to HL.
	ld a, (object_width)
	sub_hl_a
	ENDM


draw.leftward_arrow:
	;
	;    /-----/
	;   /     /
	;  /     /
	;  \     \
	;   \     \
	;    \-----\
	;

	; Locate object at right-hand side of road.
	locate_at_right

	; Size as one-quarter the width of the road.
	ld a, (object_width)
	rra
	rra
	and %00111111
	ret z

	; Move further rightward, to get the point off the track.
	push af
	add_hl_a
	pop af

	; NB: the size of this particular object means it can never overlap the top of the viewport.
	; So that simplifies some of the flow below.

	; Set up for drawing left edge.
	push af

	; Draw left edge.
	ld ixl, a							; height = scaled height

	ld d, edge.left / 256
	ld a, (screen_line)
	ld e, a								; Start drawing at screen_line.

	ld a, h
	ld h, l
	ld l, 0								; initial x position = as in HL
	ld bc, -300							; this arrow points leftward: subtract 163/256 every line
	call edge.fill.upward

	; Continue from current position, so don't touch HL:A.
	pop bc
	push bc
	ld ixl, b							; same height
	ld bc, 300							; now head to the right
	call edge.fill.upward

	; Jump over to the right-hand-side.
	inc e
	inc d

	pop bc
	push bc
	ld ixl, b							; same height

	add hl, bc
	adc 0

	ld bc, -96							; now head to the left again
	call edge.fill.downward

	; Do the second right-hand segment.
	pop bc
	push bc
	ld ixl, b							; same height
	ld bc, 96							; now head to the left again
	call edge.fill.downward

	; Output the actual spans.
	pop bc
	ld a, b
	add a, a
	ld c, a								; Height = double the height of those two segments.

	ld a, (screen_line)
	sub c
	inc a
	ld b, a								; Start position = base - height + top_y + 1.

	ld d, warning_colour				; This is a warning sign.
	push iy								; TODO: can edges.output avoid IY, somehow?
	call edges.output
	pop iy

	ret


	; How I'm imagining a car should look:
	;
	;          --------
	;             ||
	;   |----|   /  \   |----|
	;   |    |----------|    |
	;   |----|          |----|
	;
	; Maybe colour the top bar to indicate car behaviour?

@tyre_width: db 0
@spoiler_base: db 0
@spoiler_top: db 0

draw_tyre: MACRO
	ld a, (screen_line)
	ld e, a							; E = base line.

	ld a, (object_width)			; A = height of tyre.
	ld b, a
	srl b							; B = width of tyre

	ld c, tyre_colour				; C = colour of tyre.
	call rectangle
	ENDM

upper_slope: EQU 63
lower_slope: EQU 400

draw.car:
	push iy

	; HL = centre of base.

	push hl

	ld a, (object_width)
	ld e, a
	ld a, (iy + moveable.x)
	or a
	jp p, @+move_right

@move_left:
	neg
	add a, a
	jr z, @+move_left_128		; Number was initially negative, so non-zero. Therefore add a, a should be non-zero.
								; Hence if the result was zero then A = 128, which is the only value that won't fit
								; in 8-bit arithmetic. So treat it as a special case.
	ld d, a
	call multiply.u8.u8
	ld a, h
	pop hl
	sub_hl_a
	jr @+get_colour

@move_left_128:
	pop hl
	ld a, e
	sub_hl_a
	jr @+get_colour

@move_right:
	add a, a
	ld d, a
	call multiply.u8.u8
	ld a, h
	pop hl
	add_hl_a

@get_colour:
	; Get colour.
	ld a, (iy + car.colour)
	ld iyl, a

	; Adopt total object width of one half of the size of the road.
	; Which means scaling width down to a quarter because it'll be
	; added and subtracted.
	ld a, (object_width)
	add 2
	rra
	rra
	and %00111111
	ret z

	ld (object_width), a			; Update object width to being offset of a tyre.

	inc a
	srl a
	ld (@-tyre_width), a			; Tyre width = half height (in pixels).

	ld a, (object_width)
	ld e, a
	ld a, (screen_line)
	sub e
	ld (@-spoiler_base), a		; Base of spoiler = object base - one tyre height.
								; This will also be the top of the neck.

	ld a, (object_width)
	add 2
	srl a
	srl a
	ld e, a
	ld a, (@-spoiler_base)
	sub e
	ld (@-spoiler_top), a

	;
	; Draw neck leading to spoiler.
	;
	push hl

		; Left edge.
		ld e, a
		ld d, edge.left / 256	; DE = pointer to left list at bottom of spoiler.

		ld a, (@-tyre_width)
		ld ixl, a					; Draw down by half a tyre.

		ld bc, -upper_slope

		ld a, h
		ld h, l
		ld l, 0						; Rotate HL into A:HL.

		call edge.fill.downward

		ld bc, -lower_slope
		push af
		ld a, (@-tyre_width)
		ld ixl, a					; Draw down by half a tyre.
		pop af

		call edge.fill.downward

		; Right edge.
		inc d
		ld a, (@-spoiler_top)
		ld e, a						; DE = pointer to right list at bottom of spoiler.

		ld a, (@-tyre_width)
		ld ixl, a					; Draw down by half a tyre.

		ld bc, upper_slope

		pop hl
		push hl						; HL = start position.
		ld a, h
		ld h, l
		ld l, 0						; Rotate HL into A:HL.

		call edge.fill.downward

		ld bc, lower_slope
		push af
		ld a, (@-tyre_width)
		ld ixl, a					; Draw down by half a tyre.
		pop af

		call edge.fill.downward

		; Fill.

		ld d, iyl
		ld a, (@-spoiler_top)
		ld b, a
		ld a, (@-tyre_width)
		ld c, a
		add a, c
		ld c, a

		call edges.output

	pop hl

	;
	; Right-hand tyre.
	;
	ld a, (object_width)
	push hl
	add_hl_a
	draw_tyre

	;
	; Left-hand tyre.
	;
	ld a, (object_width)
	pop hl
	push hl
	sub_hl_a
	draw_tyre

	;
	; Spoiler.
	;
	pop hl							; HL = centre of object.

	ld a, (@-spoiler_base)
	ld e, a							; E = base line of spoiler.

	ld a, (object_width)
	ld b, a							; B = width.

	ld a, (object_width)
	srl a
	srl a							; A = height = object_width / 4

	ld c, iyl
	call rectangle

	pop iy

	ret

;
; rectangle
;
; Draws a solid rectangle; clamps left/right but not top/bottom.
;
; This is currently implemented going through the edge lists because
;
;	Input:
;		HL = bottom centre of rectangle.
;		E = on-screen line of base.
;		A = height.
;		B = width.
;		C = colour.
;
;	Clobbers:
;		A, IX, DE, HL, IY.
;
rectangle:
	ld ixl, a						; IXl = lines to paint, throughout.

	ld a, b
	ld (@+load_width + 1), a		; Store width.

	; Move halfway left to retain 'centre' part of contract
	srl a
	sub_hl_a

	ld a, c
	ld (@+load_colour+1), a			; Store colour.

	; Get pointer into left edge list.
	ld d, edge.left / 256
	ld a, ixl
	sub e							; A = height - base
	neg								; A = base - height
	ld e, a							; DE = correct pointer.

	ld (@+load_top + 1), a
	ld (@+reload_top + 1), a		; Store top for restoration later.

	call edge.fill.vertical.downward

	; Write to right edge list.
	inc d
@load_top:
	ld e, 0							; DE = correct pointer.

@load_width:
	ld a, 0
	add_hl_a

	call edge.fill.vertical.downward

	; Fill.
@load_colour:
	ld d, 0							; D = colour
@reload_top:
	ld b, 0
	ld c, ixl

	jp edges.output
