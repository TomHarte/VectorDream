;
; Offsets exist within a doubly-linked list.
;
; Fields (EQUd to their offsets):
;

object.depth: EQU 0			; Planar depth, i.e. along the ground, of this object.

object.draw: EQU 2			; Routine to draw an object. When called:
							;
							;	HL = centre of the road in 2d at the depth of the object;
							;	(@object_width) = width of a piece of road at the object's depth;
							;	(@base_line) = line on screen where the bottom of the object should appear.

;
; Hence, total size is:
;
object.sizeof: EQU 4

;
; A list of active objects. Each is merely a two-byte distance from the viewer, and
; a routine to draw the thing.
;
active_objects:
	dw 1000
	dw draw.car1

	dw 0xffff			; Distance from player = -1 => list terminated.
						; (though only the high byte is tested)

	dw 250
	dw draw.car2

	dw 50				; Current distance from player.
	dw draw.car3		; Draw routine.


;
; Transient storage used by objects.draw.
;
@ratio:
	db 0	; Throwaway byte to allow 16-bit stores.
	db 0	; Actual ratio.
@horizon_depth:
	dw 0

;
; Per-object transient storage shared with the draw routines.
;
object_width: db 0
@base_line: 
	db 0	; Actual value.
	db 0	; "Top byte" of value. Always 0. But allows 16-bit loads.
screen_line:
	db 0

objects.draw:

	;
	; This walks the per-line segments list, as I wanted to fit it into the
	; span-drawing loop when that list is being walked linearly anyway. Though
	; it contains early-exit logic.
	;
	; But if I'm doing this separately, a binary search or an initial broad-table
	; lookup would be worth investigating.
	;

	ld iy, active_objects

	; Loads HL with the player-relative depth of the object pointed to by IY.
	; Sets the zero flag if the list has ended.
get_player_relative_depth: MACRO
	; Get player-relative depth of current object into DE.
	ld l, (iy + object.depth)
	ld h, (iy + object.depth + 1)
	ld a, h
	inc a
	ENDM

	get_player_relative_depth
	ret z

@test_line: EQU FOR bottom_y - top_y - 1
	ld bc, depth_{@test_line + 1}			; BC = depth of line.

	; HL = (depth of object) - (depth of line).
	or a
	sbc hl, bc
	jr c, @+object_not_found		; (depth of line) <= (depth of object), so object is here.

	;
	; Precept: objects are 'rare'. So using index registers here isn't a bottleneck.
	; Conversely, this loop is unrolled so direct table loads would cast a large footprint.
	;
	ld a, @test_line + 1
	ld ix, segments + 4 * @test_line
	call @+object_found

@object_not_found:
	add hl, bc		; Restore depth of object.

NEXT @test_line
	ret



@object_found:
	;
	; At entry:
	;
	;	A = base line.
	;	IY = pointer to object.
	;	IX = pointer to line before in segments table.
	;	HL = (depth of object) - (depths of line object is on).
	;	BC = .depth of line object is on.
	;
	; Should preserve IY. Everything else isn't important.

	ld (@-base_line), a

	ld e, (ix + 2)
	ld d, (ix + 3)
	ex de, hl						; HL = depth of previous line.
	or a
	sbc hl, bc

		; HL = difference in depths between line object is on and line before.
		; DE = difference in depths between line object is on and object.

	call getratio.uf16.uf16	; B = DE / HL, required ratio, in 0:8 fixed point.

	;
	; Up to here:
	;
	;	@base_line is populated.
	;	L = ratio (in 0:8 fixed point) of (object depth - closer line depth) / (further line depth - closer line depth).
	;
	; So from here:
	;
	;	Index into road.centres at [a] and [a-1]. Apply ratio to get centre of road at object depth.
	;	Index into segments at [a] and [a-1] to get road widths. Apply ratio to get width of road at object depth.
	;	Draw object with width and x offset that is some multiple of segments-derived calculation, at x = offset + interpolated road centre; bottom y = top_y + A.
	;

	; Possible TODO: special case possible if B = 0.

	; Store ratio (along with redundant write of C).
	ld (@-ratio), bc
	ld e, b

	; Work out interpolated size.
	ld a, (ix + 1)
	ld b, a				; Width at previous line.
	ld a, (ix + 5)		; Width at current line.

	sub b			; Difference in road width.
	ld d, a

	call multiply.u8.u8

	; H = amount to subtract from width at closer value.
	ld a, (ix + 5)
	sub h
	ld (object_width), a		; Establish object width.

	;
	; Grab relevant values from road position table.
	;

	ld hl, road.centres
	ld de, (@-base_line)
	add hl, de
	add hl, de				; HL = pointer into road.centres.

	ld e, (hl)
	inc l
	ld d, (hl)				; DE = centre at previous line.
	inc hl
	ld c, (hl)
	inc l
	ld b, (hl)				; BC = centre at current line.
	push bc

	ex de, hl
	sbc hl, bc		; HL = (centre at line above) - (centre at line)
					; Which is always less than a byte-sized quantity, per corner constraints.
					; Carry is left over from `add hl, de` above so is guaranteed clear.
	; jr z, @+no_interpolate
	; jp m, @+negative_interpolate
	jr @+no_interpolate

	;
	; Perform BC += (ratio * l).
	;

	ld de, (@-ratio)	; D = ratio.
	ld e, l
	call multiply.u8.u8

	ld c, h
	ld b, 0

	pop hl
	add hl, bc
	jr @+draw_object

@negative_interpolate:
	;
	; Perform BC -= (ratio * -l).
	;

	ld de, (@-ratio)	; D = ratio.
	ld a, l
	neg
	ld e, a				; D = -l

	call multiply.u8.u8

	ld c, h
	ld b, 0

	or a
	pop hl
	sbc hl, bc

@draw_object:
	;
	; HL = centre to use.
	;

	ld a, (@-base_line)
	add top_y
	ld (screen_line), a

	ld e, (iy + object.draw)
	ld d, (iy + object.draw + 1)
	ld (@+call_draw + 1), de
@call_draw:
	call 0

	;
	; Advance IY to closer object and continue if one exists.
	;
;	ld e, (iy + object.closer)
;	ld d, (iy + object.closer + 1)
;	ld a, e
;	or d
;	jr z, @+double_ret
;	ld iyl, e
;	ld iyh, d
	ld bc, object.sizeof
	add iy, bc

	get_player_relative_depth		; Get new depth.
	ld bc, 0						; If if the ret nz takes effect, an add hl, bc will occur. Ensure that's a no-op.
	ret nz

@double_ret:
	pop bc							; Latest object is behind camera. Force a double-ret.
	ret

@no_interpolate:
	pop af				; Throw away depth stored on the stack.
	ld h, b
	ld l, c
	jr @-draw_object

;
; Drawing routines:
;
; HL = centre of object; other parameters are in memory.
; Must preserve IY.
;


add_hl_a: MACRO
	add a, l
	ld l, a
	adc h
	sub l
	ld h, a
	ENDM

sub_hl_a: MACRO
	neg					; Assumed: A is non-zero.
	add l
	ld l, a
	ld a, 0xff
	adc h
	ld h, a
	ENDM

locate_at_right: MACRO
	; Add the 8-bit value (object_width) to HL.
	ld a, (object_width)
	sub_hl_a
	ENDM


draw.leftward_arrow:
	;
	;    /-----/
	;   /     /
	;  /     /
	;  \     \
	;   \     \
	;    \-----\
	;

	; Locate object at right-hand side of road.
	locate_at_right

	; Size as one-quarter the width of the road.
	ld a, (object_width)
	rra
	rra
	and %00111111
	ret z

	; Move further rightward, to get the point off the track.
	push af
	add_hl_a
	pop af

	; NB: the size of this particular object means it can never overlap the top of the viewport.
	; So that simplifies some of the flow below.

	; Set up for drawing left edge.
	push af

	; Draw left edge.
	ld ixl, a							; height = scaled height

	ld d, edge.left / 256
	ld a, (screen_line)
	ld e, a								; Start drawing at screen_line.

	ld a, h
	ld h, l
	ld l, 0								; initial x position = as in HL
	ld bc, -300							; this arrow points leftward: subtract 163/256 every line
	call edge.fill.upward

	; Continue from current position, so don't touch HL:A.
	pop bc
	push bc
	ld ixl, b							; same height
	ld bc, 300							; now head to the right
	call edge.fill.upward

	; Jump over to the right-hand-side.
	inc e
	inc d

	pop bc
	push bc
	ld ixl, b							; same height

	add hl, bc
	adc 0

	ld bc, -96							; now head to the left again
	call edge.fill.downward

	; Do the second right-hand segment.
	pop bc
	push bc
	ld ixl, b							; same height
	ld bc, 96							; now head to the left again
	call edge.fill.downward

	; Output the actual spans.
	pop bc
	ld a, b
	add a, a
	ld c, a								; Height = double the height of those two segments.

	ld a, (screen_line)
	sub c
	inc a
	ld b, a								; Start position = base - height + top_y + 1.

	ld d, colour.warning				; This is a warning sign.
	push iy								; TODO: can edges.output avoid IY, somehow?
	call edges.output
	pop iy

	ret


	; How I'm imagining a car should look:
	;
	;          --------
	;             ||
	;   |----|   /  \   |----|
	;   |    |----------|    |
	;   |----|          |----|
	;
	; Maybe colour the top bar to indicate car behaviour?

@tyre_width: db 0
@spoiler_base: db 0
@spoiler_top: db 0

draw_tyre: MACRO
	ld a, (screen_line)
	ld e, a							; E = base line.

	ld a, (object_width)			; A = height of tyre.
	ld b, a
	srl b							; B = width of tyre

	ld c, colour.tyre				; C = colour of tyre.
	call rectangle
	ENDM

upper_slope: EQU 63
lower_slope: EQU 400

draw.car1:
	push iy
	ld a, -128
	ld iyl, colour.car.blue
	jr @+draw.car

draw.car2:
	push iy
	ld a, 67
	ld iyl, colour.car.red
	jr @+draw.car

draw.car3:
	push iy
	ld a, -10
	ld iyl, colour.car.red
	jr @+draw.car

@draw.car:
	; HL = centre of base.

	push hl

	or a
	jp p, @+move_right

@move_left:
	neg
	add a, a
	jr z, @+move_left_128		; Number was initially negative, so non-zero. Therefore add a, a should be non-zero.
								; Hence if the result was zero then A = 128, which is the only value that won't fit
								; in 8-bit arithmetic. So treat it as a special case.
	ld d, a
	ld a, (object_width)
	ld e, a
	call multiply.u8.u8
	ld a, h
	pop hl
	sub_hl_a
	jr @+finish_placement

@move_left_128:
	pop hl
	ld a, (object_width)
	sub_hl_a
	jr @+finish_placement

@move_right:
	add a, a
	ld d, a
	ld a, (object_width)
	ld e, a
	call multiply.u8.u8
	ld a, h
	pop hl
	add_hl_a

@finish_placement:

	; Adopt total object width of one half of the size of the road.
	; Which means scaling width down to a quarter because it'll be
	; added and subtracted.
	ld a, (object_width)
	add 2
	rra
	rra
	and %00111111
	ret z

	ld (object_width), a			; Update object width to being offset of a tyre.

	inc a
	srl a
	ld (@-tyre_width), a			; Tyre width = half height (in pixels).

	ld a, (object_width)
	ld e, a
	ld a, (screen_line)
	sub e
	ld (@-spoiler_base), a		; Base of spoiler = object base - one tyre height.
								; This will also be the top of the neck.

	ld a, (object_width)
	add 2
	srl a
	srl a
	ld e, a
	ld a, (@-spoiler_base)
	sub e
	ld (@-spoiler_top), a

	;
	; Draw neck leading to spoiler.
	;
	push hl

		; Left edge.
		ld e, a
		ld d, edge.left / 256	; DE = pointer to left list at bottom of spoiler.

		ld a, (@-tyre_width)
		ld ixl, a					; Draw down by half a tyre.

		ld bc, -upper_slope

		ld a, h
		ld h, l
		ld l, 0						; Rotate HL into A:HL.

		call edge.fill.downward

		ld bc, -lower_slope
		push af
		ld a, (@-tyre_width)
		ld ixl, a					; Draw down by half a tyre.
		pop af

		call edge.fill.downward

		; Right edge.
		inc d
		ld a, (@-spoiler_top)
		ld e, a						; DE = pointer to right list at bottom of spoiler.

		ld a, (@-tyre_width)
		ld ixl, a					; Draw down by half a tyre.

		ld bc, upper_slope

		pop hl
		push hl						; HL = start position.
		ld a, h
		ld h, l
		ld l, 0						; Rotate HL into A:HL.

		call edge.fill.downward

		ld bc, lower_slope
		push af
		ld a, (@-tyre_width)
		ld ixl, a					; Draw down by half a tyre.
		pop af

		call edge.fill.downward

		; Fill.

		ld d, iyl
		ld a, (@-spoiler_top)
		ld b, a
		ld a, (@-tyre_width)
		ld c, a
		add a, c
		ld c, a

		call edges.output

	pop hl

	;
	; Right-hand tyre.
	;
	ld a, (object_width)
	push hl
	add_hl_a
	draw_tyre

	;
	; Left-hand tyre.
	;
	ld a, (object_width)
	pop hl
	push hl
	sub_hl_a
	draw_tyre

	;
	; Spoiler.
	;
	pop hl							; HL = centre of object.

	ld a, (@-spoiler_base)
	ld e, a							; E = base line of spoiler.

	ld a, (object_width)
	ld b, a							; B = width.

	ld a, (object_width)
	srl a
	srl a							; A = height = object_width / 4

	ld c, iyl
	call rectangle

	pop iy

	ret

;
; rectangle
;
; Draws a solid rectangle; clamps left/right but not top/bottom.
;
; This is currently implemented going through the edge lists because
;
;	Input:
;		HL = bottom centre of rectangle.
;		E = on-screen line of base.
;		A = height.
;		B = width.
;		C = colour.
;
;	Clobbers:
;		A, IX, DE, HL, IY.
;
rectangle:
	ld ixl, a						; IXl = lines to paint, throughout.

	ld a, b
	ld (@+load_width + 1), a		; Store width.

	; Move halfway left to retain 'centre' part of contract
	srl a
	sub_hl_a

	ld a, c
	ld (@+load_colour+1), a			; Store colour.

	; Get pointer into left edge list.
	ld d, edge.left / 256
	ld a, ixl
	sub e							; A = height - base
	neg								; A = base - height
	ld e, a							; DE = correct pointer.

	ld (@+load_top + 1), a
	ld (@+reload_top + 1), a		; Store top for restoration later.

	call edge.fill.vertical.downward

	; Write to right edge list.
	inc d
@load_top:
	ld e, 0							; DE = correct pointer.

@load_width:
	ld a, 0
	add_hl_a

	call edge.fill.vertical.downward

	; Fill.
@load_colour:
	ld d, 0							; D = colour
@reload_top:
	ld b, 0
	ld c, ixl

	jp edges.output
