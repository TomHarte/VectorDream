;
; Object fields (EQUd to their offsets):
;

offset.object.depth: EQU 0			; Planar depth, i.e. along the ground, of this object.

offset.object.draw: EQU 2			; Draw block for object. When called:
							;
							;	HL = centre of the road in 2d at the depth of the object;
							;	(@object_width) = width of a piece of road at the object's depth;
							;	(@base_line) = line on screen where the bottom of the object should appear.

;
; Hence, total size is:
;
sizeof.object: EQU 4


;
; A draw block is primarily the code necessary to draw the object; it also has indirections
; towards the code necessary to update and to test collisions with an object.
;
; Although drawing will occur **at most** as often as updating and collision testing,
; neither of those is likely to be unique in the general case — e.g. all static objects will
; have the same update function; all static objects of the same size will have the same
; collision function.
;
offset.drawblock.draw:		EQU 0	; Code for drawing is the thing pointed to by a draw block.
offset.drawblock.update:	EQU -3	; Three bytes before the drawing code is a JP to the update code.
offset.drawblock.collide:	EQU -6	; Six bytes before that is a JP to the update code.

;
; A list of active objects. Each is merely a two-byte distance from the viewer, and
; a routine to draw the thing.
;

@active_dummy:
	; A dummy object immediately before the list; this means that a backwards search
	; when sorting wlll always stop at the start of the list.
	dw 0xffff
	dw 0


active_objects.count: EQU 8

active_objects:
@object: EQU FOR active_objects.count
	dw 0xffff			; Distance from player = -1 => list terminated.
						; (though only the high byte is tested)
	dw 0
NEXT @object

@end_of_objects:
	; A dummy object straight after the list; if this address is the result of
	; searching for an empty slot, none are available.
	dw 0xffff
	dw 0

ASSERT (@end_of_objects >> 8) == (@active_dummy >> 8)


;
; object.collide
;
; Performs the object-specific collision logic, testing horizontal position and
; reacting as appropriate.
;
;	Input:
;		HL = pointer to draw block.
;
object.collide:
	dec hl
	dec hl
	dec hl
	; [[fallthrough]]

;
; object.update
;
; Performs the object-specific update logic.
;
;	Input:
;		HL = pointer to draw block;
;		DE = pointer to object within object list.
;
object.update:
	dec hl
	dec hl
	dec hl

	jp (hl)

;
; active_objects.erase
;
; Removes the object at (DE) from the list.
;
; 	Input:
;		DE = pointer to object to remove from the list.
;
; 	Output:
;		None; the object will have been removed from the list.
;
;	Clobbers:
;		A, BC, DE, HL.
;
active_objects.erase:
	ld h, d
	ld l, e

	ASSERT sizeof.object == 4
	inc l
	inc l
	inc l
	inc l

@move_entry:
	; Copy distance from camera.
	ldi
	ld a, (hl)		; Grab a copy of the high byte of distance of the incoming object as it passes by.
	ldi

	; Exit if the terminator has just been copied down.
	inc a
	ret z

	; Copy update function and repeat.
	ldi
	ldi
	jr @-move_entry


;
; active_objects.back_reserve
;
; Reserves an object slot at the back of the list, i.e. **closest** to the viewer,
; if one is available.
;
; 	Input:
;		None.
;
; 	Output:
;		HL = address of reserved slot, if one was found;
;		carry = clear if a slot was found, set otherwise.
;
;	Clobbers:
;		A.
;
active_objects.back_reserve:
	; Check whether the slot at end_of_objects - 4 is empty.
	; If not then the list is full.
	ld a, (@end_of_objects - sizeof.object + offset.object.depth + offset.word.byte.high)
	inc a
	jr z, @+do_insert

	; List is full. Sorry!
	scf
	ret

@do_insert:
	; Find the first available slot.

	ld hl, active_objects + 1
@test_slot:
	ld a, (hl)
	inc a
	jr z, @+found_slot

	inc l
	inc l
	inc l
	inc l
	jr @-test_slot

@found_slot:
	dec l
	or a
	ret


;
; active_objects.front_reserve
;
; Reserves an object slot at the front of the list, i.e. **furthest** to the viewer,
; if one is available.
;
; 	Input:
;		None.
;
; 	Output:
;		HL = address of reserved slot, if one was found;
;		carry = clear if a slot was found, set otherwise.
;
;	Clobbers:
;		A, BC, DE.
;
active_objects.front_reserve:
	; Check whether the slot at end_of_objects - 4 is empty.
	; If not then the list is full.
	ld a, (@end_of_objects - sizeof.object + offset.object.depth + offset.word.byte.high)
	inc a
	jr z, @+do_insert

	; List is full. Sorry!
	scf
	ret

@do_insert:
	; Open up the front slot with a lazy LDDR.
	; TODO: can improve.
	ld de, active_objects + active_objects.count * sizeof.object - 1
	ld hl, active_objects + active_objects.count * sizeof.object - 1 - sizeof.object
	ld bc, (active_objects.count - 1) * sizeof.object
	lddr

	; Return front slot.
	ld hl, active_objects
	or a
	ret

;
; Compares the object at IY + sizeof.object to the object at IY.
;
; The first macro argument provides the current location of the high byte of the object at IY + sizeof.object.
;
; Performs a 16-bit subtract (one byte at a time, per fetching-from-IY limitations),
; setting all flags SBC usually sets.
;
compare: MACRO
	ld a, (iy + sizeof.object + offset.object.depth + offset.word.byte.low)
	sub (iy + offset.object.depth + offset.word.byte.low)
	ld a, \0
	sbc (iy + offset.object.depth + offset.word.byte.high)
	ENDM

;
; Swaps the single byte at IY + [macro argument] with the one at IY + [macro argument] + sizeof.object
;
; Clobbers DE.
;
swap_byte: MACRO
	ld e, (iy + \0)
	ld d, (iy + sizeof.object + \0)
	ld (iy + \0), d
	ld (iy + sizeof.object + \0), e
	ENDM

;
; active_objects.sort
;
; Sorts the current active_objects list so that the furthest comes first.
;
; Warning: this is not a stable sort. Objects at the same depth may change positions.
;
; 	Input:
;		None.
;
; 	Output:
;		None; as a side effect the active_objects list will now be sorted.
;
;	Clobbers:
;		A, IY, BC, DE.
;
active_objects.sort:
	;
	; This is a game where the object list is probably either already sorted, or is close to being properly sorted.
	; So insertion sort is appropriate.
	;
	ld iy, active_objects

	;
	; Exit immediately if list is empty.
	;
	ld a, (iy + offset.object.depth + offset.word.byte.high)
	inc a
	ret z

	;
	; Seed BC as an adder for moving through the list.
	;
	ld de, sizeof.object

@test_object:
	;
	; Test whether next thing is the end of the list.
	;
	ld a, (iy + sizeof.object + offset.object.depth + offset.word.byte.high)
	ld b, a		; Keep high byte of depth of next object to avoid a double fetch.
	inc a
	ret z

	; If ordering is incorrect, branch to order adjustment.
	compare b
	jr nc, @+adjust_order

	; Ordering correct: just advance.
@advance:
	add iy, de
	jr @-test_object

;
; If here then the object at IY + 1 should be before the object at IY.
; Indeed it could need to be arbitrarily far back in the list.
; So, insertion-sort-style, recede and swap objects at each step until
; the object is in the correct place.
;
@adjust_order:

	push iy
	ld bc, -sizeof.object
@test_next:
	;
	; Alas pyz80 seems to have issues doing anything neater with the below;
	; symbols don't seem to be propagating correctly into macros right now
	; so the EQU FOR I was clearly reaching for is out.
	;
	ASSERT sizeof.object == 4
	swap_byte 0
	swap_byte 1
	swap_byte 2
	swap_byte 3
	add iy, bc

	compare (iy + sizeof.object + offset.object.depth + offset.word.byte.high)
	jr nc, @-test_next

	;
	; Restore the ordinary order of things and return to the main loop.
	;
	; This routine took the object at IY + sizeof.object and shuffled it
	; somewhere earlier in the list. What's now at IY + sizeof.object
	; will be whatever was at IY. Advance to it.
	;
	pop iy
	ld de, sizeof.object
	add iy, de
	jr @-test_object
