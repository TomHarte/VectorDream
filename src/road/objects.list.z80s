;
; Object fields (EQUd to their offsets):
;

object.depth: EQU 0			; Planar depth, i.e. along the ground, of this object.

object.draw: EQU 2			; Draw block for object. When called:
							;
							;	HL = centre of the road in 2d at the depth of the object;
							;	(@object_width) = width of a piece of road at the object's depth;
							;	(@base_line) = line on screen where the bottom of the object should appear.

;
; Hence, total size is:
;
object.sizeof: EQU 4


;
; A draw block is primarily the code necessary to draw the object; it also has indirections
; towards the code necessary to update and to test collisions with an object.
;
; Although drawing will occur **at most** as often as updating and collision testing,
; neither of those is likely to be unique in the general case — e.g. all static objects will
; have the same update function; all static objects of the same size will have the same
; collision function.
;
drawblock.drawcode:		EQU 0	; Code for drawing is the thing pointed to by a draw block.
drawblock.update_jp:	EQU -3	; Three bytes before the drawing code is a JP to the update code.
drawblock.collide_jp:	EQU -6	; Six bytes before that is a JP to the update code.

;
; A list of active objects. Each is merely a two-byte distance from the viewer, and
; a routine to draw the thing.
;

@active_dummy:
	; A dummy object immediately before the list; this means that a backwards search
	; when sorting wlll always stop at the start of the list.
	dw 0xffff
	dw 0


active_objects.count: EQU 8

active_objects:
@object: EQU FOR active_objects.count
	dw 0xffff			; Distance from player = -1 => list terminated.
						; (though only the high byte is tested)
	dw 0
NEXT @object

@end_of_objects:
	; A dummy object straight after the list; if this address is the result of
	; searching for an empty slot, none are available.
	dw 0xffff
	dw 0

ASSERT (@end_of_objects >> 8) == (@active_dummy >> 8)

;
; active_objects.erase
;
; Removes the object at (DE) from the list.
;
; 	Input:
;		DE = pointer to object to remove from the list.
;
; 	Output:
;		None; the object will have been removed from the list.
;
;	Clobbers:
;		A, BC, DE, HL.
;
active_objects.erase:
	ld h, d
	ld l, e

	ASSERT object.sizeof == 4
	inc l
	inc l
	inc l
	inc l

@move_entry:
	; Copy distance from camera.
	ldi
	ld a, (hl)		; Grab a copy of the high byte of distance of the incoming object as it passes by.
	ldi

	; Exit if the terminator has just been copied down.
	inc a
	ret z

	; Copy update function and repeat.
	ldi
	ldi
	jr @-move_entry


;
; active_objects.back_reserve
;
; Reserves an object slot at the back of the list, i.e. **closest** to the viewer,
; if one is available.
;
; 	Input:
;		None.
;
; 	Output:
;		HL = address of reserved slot, if one was found;
;		carry = clear if a slot was found, set otherwise.
;
;	Clobbers:
;		A.
;
active_objects.back_reserve:
	; Check whether the slot at end_of_objects - 4 is empty.
	; If not then the list is full.
	ld a, (@end_of_objects - object.sizeof + object.depth + 1)
	inc a
	jr z, @+do_insert

	; List is full. Sorry!
	scf
	ret

@do_insert:
	; Find the first available slot.

	ld hl, active_objects + 1
@test_slot:
	ld a, (hl)
	inc a
	jr z, @+found_slot

	inc l
	inc l
	inc l
	inc l
	jr @-test_slot

@found_slot:
	dec l
	or a
	ret


;
; active_objects.front_reserve
;
; Reserves an object slot at the front of the list, i.e. **furthest** to the viewer,
; if one is available.
;
; 	Input:
;		None.
;
; 	Output:
;		HL = address of reserved slot, if one was found;
;		carry = clear if a slot was found, set otherwise.
;
;	Clobbers:
;		A, BC, DE.
;
active_objects.front_reserve:
	; Check whether the slot at end_of_objects - 4 is empty.
	; If not then the list is full.
	ld a, (@end_of_objects - object.sizeof + object.depth + 1)
	inc a
	jr z, @+do_insert

	; List is full. Sorry!
	scf
	ret

@do_insert:
	; Open up the front slot with a lazy LDDR.
	; TODO: can improve.
	ld de, active_objects + active_objects.count * object.sizeof - 1
	ld hl, active_objects + active_objects.count * object.sizeof - 1 - object.sizeof
	ld bc, (active_objects.count - 1) * object.sizeof
	lddr

	; Return front slot.
	ld hl, active_objects
	or a
	ret

;
; active_objects.sort
;
; Sorts the current active_objects list so that the furthest comes first.
;
; Warning: this is not a stable sort. Objects at the same depth may change positions.
;
; 	Input:
;		None.
;
; 	Output:
;		None; as a side effect the active_objects list will now be sorted.
;
;	Clobbers:
;		A, IY, BC, DE.
;
active_objects.sort:
	;
	; This is a game where the object list is probably either already sorted, or is close to being properly sorted.
	; So insertion sort is appropriate.
	;

	ld iy, active_objects

	;
	; Exit immediately if list is empty.
	;
	ld a, (iy + object.depth + 1)
	inc a
	ret z

@test_object:
	;
	; Test for end of list.
	;
	ld a, (iy + object.sizeof + object.depth + 1)
	ld b, a		; Keep high byte of depth of next object to avoid a double fetch.
	inc a
	ret z

	;
	; Compare depth of object one ahead of this one and this one.
	;
	compare: MACRO
		ld a, (iy + object.sizeof + object.depth + 0)
		sub (iy + object.depth + 0)
		ld a, \0
		sbc (iy + object.depth + 1)
	ENDM
	compare b

	; Ordering incorrect: search backwards to find out where the next object should be,
	; and move list data appropriately.
	jr nc, @+adjust_order

	; Ordering correct: just advance.
@advance:
	ld bc, object.sizeof
	add iy, bc
	jr @-test_object

@adjust_order:
	push iy

	ld bc, -4
@test_next:
	; Swap object and one before it, then recede and compare again.
	swap: MACRO
		ld e, (iy + \0)
		ld d, (iy + object.sizeof + \0)
		ld (iy + \0), d
		ld (iy + object.sizeof + \0), e
	ENDM

	swap (object.depth + 0)
	swap (object.depth + 1)
	swap (object.draw + 0)
	swap (object.draw + 1)

	add iy, bc

	compare (iy + object.sizeof + object.depth + 1)
	jr nc, @-test_next

	pop iy
	jr @-advance
