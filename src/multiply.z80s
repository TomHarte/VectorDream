;
; multiply.u8.u8
;
; Performs a u8 x u8 -> u16 multiply.
;
;	Input:
;		D, E = operands.
;
;	Output:
;		HL = D*E
;
;	Clobbers:
;		A, BC.
;
multiply.u8.u8:
	; Get BC = ((d - e)^2) / 4 taking abs(d - e) if necessary.
	ld a, d
	sub e

	jr nc, @+no_neg
	neg

@no_neg:
	ld h, squares / 256
	ld l, a

	ld c, (hl)
	inc h
	ld b, (hl)

	; Get HL = ((d + e)^2) / 4
	ld a, d
	add e

	jr nc, @+low_page

	ld h, 2 + squares / 256
	ld l, a
	ld a, (hl)
	inc h
	ld h, (hl)
	ld l, a

	; Subtract the two things and return.
	or a
	sbc hl, bc
	ret

@low_page:
	ld h, squares / 256
	ld l, a
	ld a, (hl)
	inc h
	ld h, (hl)
	ld l, a

	or a
	sbc hl, bc
	ret
