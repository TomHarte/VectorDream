X_: EQU 0x10
XX: EQU 0x11
_X: EQU 0x01
__: EQU 0x00

;
; Graphics for 'FUEL' and 'RPM'.
;
@fuel:
	db XX, X_, 		X_, X_,		XX,	X_,		X_, __
	db X_, __, 		X_, X_,		X_, __,		X_, __
	db XX, X_, 		X_, X_,		XX, X_,		X_, __
	db X_, __, 		X_, X_,		X_, __,		X_, __
	db X_, __, 		XX, X_,		XX, X_,		XX, X_

@rpm:
	db XX, X_, _X, XX, __, XX, _X, X_
	db X_, _X, _X, __, X_, X_, X_, X_
	db XX, X_, _X, XX, __, X_, __, X_
	db X_, _X, _X, __, __, X_, __, X_
	db X_, _X, _X, __, __, X_, __, X_


@fuel_x: EQU 4				; Must be a multiple of 2.
@fuel_y: EQU 4				; Must keep the entire graphic within a single 32-line page.

@rpm_x: EQU 254 - 16 - @fuel_x	; Same constraint as above.
@rpm_y: EQU @fuel_y			; Ditto.

@image_width:	EQU 8		; In bytes; implied by the graphics above.
@image_height:	EQU 5		; In rows; also implied by the graphics above.
@bar_width:		EQU 64		; The space reserved for the relevant bars.
@spacer:		EQU 2		; Space between image and the start of each bar.

;
; Copies the RPM and fuel graphics into place in the frame buffer.
; This is called just once, at startup, so it doesn't need to be fast.
;
; At this point the frame buffer will be accessible from 0x8000.
;
install_fuel_rpm:
	;
	; RPM.
	;
	ld de, 0x8000 + 0x80 * @rpm_y + (@rpm_x / 2)
	ld hl, @-rpm
	call @+copy_graphic

	;
	; FUEL.
	;
	ld de, 0x8000 + 0x80 * @fuel_y + (@fuel_x / 2)
	ld hl, @-fuel
	call @+copy_graphic

	ret

@copy_graphic:
	ld ixl, @image_height
@copy_line:
	ld bc, @image_width
	ldir

	ex de, hl
	ld bc, 0x80 - @image_width
	add hl, bc
	ex de, hl

	dec ixl
	jr nz, @-copy_line

	ret

;
; Adds blank spans to avoid the span buffer overwriting the fuel and RPM gauges.
;
protect_fuel_rpm:

	;
	; Protect 'RPM'.
	; Implicit assumption: gauge goes **to the left**.
	;
	ld a, @-rpm_y
	call spans.getaddress

	ld b, @rpm_x - @spacer - @bar_width
	ld c, @rpm_x + @image_width * 2

@fill: EQU for @image_height
	ld d, 0
	call spans.overprint

	IF @fill != @image_height - 1
		inc h
		ld l, 0
	ENDIF

	NEXT @fill

	;
	; Protect 'fuel'.
	; Implicit assumption: gauge goes **to the right**.
	;
	ld a, @-fuel_y
	call spans.getaddress

	ld b, @fuel_x
	ld c, @fuel_x + @spacer + @bar_width + @image_width * 2

@fill: EQU for @image_height
	ld d, 0
	call spans.overprint

	IF @fill != @image_height - 1
		inc h
		ld l, 0
	ENDIF

	NEXT @fill

	ret
