X_: EQU 0x10
XX: EQU 0x11
_X: EQU 0x01
__: EQU 0x00

;
; Graphics for 'FUEL' and 'RPM'.
;
@fuel:
	db XX, X_, 		X_, X_,		XX,	X_,		X_, __
	db X_, __, 		X_, X_,		X_, __,		X_, __
	db XX, X_, 		X_, X_,		XX, X_,		X_, __
	db X_, __, 		X_, X_,		X_, __,		X_, __
	db X_, __, 		XX, X_,		XX, X_,		XX, X_

@rpm:
	db XX, X_, _X, XX, __, XX, _X, X_
	db X_, _X, _X, __, X_, X_, X_, X_
	db XX, X_, _X, XX, __, X_, __, X_
	db X_, _X, _X, __, __, X_, __, X_
	db X_, _X, _X, __, __, X_, __, X_


@fuel_x: EQU 2			; Must be a multiple of 2.
@fuel_y: EQU 1			; Must keep the entire graphic within a single 32-line page.

@rpm_x: EQU 238			; Same constraint as above.
@rpm_y: EQU @fuel_y		; Ditto.

;
; Copies the RPM and fuel graphics into place in the frame buffer.
; This is called just once, at startup, so it doesn't need to be fast.
;
; At this point the frame buffer will be accessible from 0x8000.
;
install_fuel_rpm:
	;
	; RPM.
	;
	ld de, 0x8000 + 0x80 * @rpm_y + (@rpm_x / 2)
	ld hl, @-rpm
	call @+copy_graphic

	;
	; FUEL.
	;
	ld de, 0x8000 + 0x80 * @fuel_y + (@fuel_x / 2)
	ld hl, @-fuel
	call @+copy_graphic

	ret

@copy_graphic:
	ld ixl, 5		; For five lines...
@copy_line:
	ld bc, 8		; Copy 8 pixels.
	ldir

	ex de, hl
	ld bc, 0x80 - 8
	add hl, bc
	ex de, hl

	dec ixl
	jr nz, @-copy_line

	ret

;
; Adds blank spans to avoid the span buffer overwriting the fuel and RPM gauges.
;
protect_fuel_rpm:

	;
	; Protect 'RPM'.
	;
	ld a, @-rpm_y
	call spans.getaddress

	ld b, @rpm_x
	ld c, @rpm_x + 16

@fill: EQU for 5
	ld d, 0
	call spans.overprint

	IF @fill != 4
		inc h
		ld l, 0
	ENDIF

	NEXT @fill

	;
	; Protect 'fuel'.
	;
	ld a, @-fuel_y
	call spans.getaddress

	ld b, @fuel_x
	ld c, @fuel_x + 16

@fill: EQU for 5
	ld d, 0
	call spans.overprint

	IF @fill != 4
		inc h
		ld l, 0
	ENDIF

	NEXT @fill

	ret
