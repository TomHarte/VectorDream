X_: EQU 0x10
XX: EQU 0x11
_X: EQU 0x01
__: EQU 0x00

@current_rpm: db 0

;
; Graphics for 'FUEL' and 'RPM'.
;
@fuel:
	db _X, XX, 		_X, _X,		_X,	XX,		_X, __
	db _X, __, 		_X, _X,		_X, __,		_X, __
	db _X, XX, 		_X, _X,		_X, XX,		_X, __
	db _X, __, 		_X, _X,		_X, __,		_X, __
	db _X, __, 		_X, XX,		_X, XX,		_X, XX

@rpm:
	db XX, __, XX, __, XX, _X, X_, __
	db X_, X_, X_, X_, X_, X_, X_, __
	db XX, __, XX, __, X_, __, X_, __
	db X_, X_, X_, __, X_, __, X_, __
	db X_, X_, X_, __, X_, __, X_, __


@rpm_x: EQU 4					; Must be a multiple of 2.
@rpm_y: EQU 4					; Must keep the entire graphic within a single 32-line page.

@fuel_x: EQU 254 - 16 - @rpm_x	; Same constraint as above.
@fuel_y: EQU @rpm_y				; Ditto.

@rpm_width:		EQU 7		; In bytes; implied by the graphics above.
@fuel_width:	EQU 8
@max_width:		EQU 8

@image_height:	EQU 5		; In rows; also implied by the graphics above.
@bar_width:		EQU 63		; The space reserved for the relevant bars.
@spacer:		EQU 1		; Space between image and the start of each bar.

;
; Copies the RPM and fuel graphics into place in the frame buffer.
; This is called just once, at startup, so it doesn't need to be fast.
;
; At this point the frame buffer will be accessible from 0x8000.
;
install_fuel_rpm:
	;
	; Fuel.
	;
	ld de, 0x8000 + 0x80 * @fuel_y + (@fuel_x / 2)
	ld hl, @-fuel
	call @+copy_graphic

	;
	; RPM.
	;
	ld de, 0x8000 + 0x80 * @rpm_y + (@rpm_x / 2)
	ld hl, @-rpm
	call @+copy_graphic

	ret

@copy_graphic:
	ld ixl, @image_height
@copy_line:
	ld bc, @max_width
	ldir

	ex de, hl
	ld bc, 0x80 - @max_width
	add hl, bc
	ex de, hl

	dec ixl
	jr nz, @-copy_line

	ret

;
; Adds blank spans to avoid the span buffer overwriting the fuel and RPM gauges.
;
protect_fuel_rpm:

	;
	; Protect 'Fuel'.
	; Implicit assumption: gauge goes **to the left**.
	;
	ld a, @-fuel_y
	call spans.getaddress

	ld b, @fuel_x - @spacer - @bar_width
	ld c, @fuel_x + @fuel_width * 2

@fill: EQU for @image_height
	ld d, 0
	call spans.overprint

	IF @fill != @image_height - 1
		inc h
		ld l, 0
	ENDIF

	NEXT @fill

	;
	; Protect 'RPM'.
	; Implicit assumption: gauge goes **to the right**.
	;
	ld a, @-rpm_y
	call spans.getaddress
	push hl

	ld b, @rpm_x
	ld c, @rpm_x + @rpm_width * 2 + @spacer + @bar_width

@fill: EQU for @image_height
	ld d, 0
	call spans.overprint

	IF @fill != @image_height - 1
		inc h
		ld l, 0
	ENDIF

	NEXT @fill

	;
	; Install RPM bar.
	;
	pop hl
@bar_start: EQU @rpm_x + @rpm_width * 2 + @spacer
	ld b, @bar_start
	ld a, (@current_rpm)
	or a
	jr z, @+no_rpm_bar
	add b
	ld c, a

	ld ixh, colour.rpm.slow
	cp 40 + @bar_start
	jr c, @+fill_rpm_bar

	ld ixh, colour.rpm.medium
	cp 56 + @bar_start
	jr c, @+fill_rpm_bar

	ld ixh, colour.rpm.fast

@fill_rpm_bar:
@fill: EQU for @image_height
	ld d, ixh
	call spans.overprint

	IF @fill != @image_height - 1
		inc h
		ld l, 0
	ENDIF

	NEXT @fill

@no_rpm_bar:
	ret

;
; Called from 'update' to set the new RPM gauge reading.
; H will be the current value in the range 0 to 63.
;
update_rpm:
	; Store current RPM.
	ld a, h
	ld (@-current_rpm), a
	ret
